# acl: setfacl grants libvirt-qemu execute-only traversal of the 0700 vault so
# the non-root VMs can reach their disks without loosening permissions (R8-1).
acl
# tpm2-tools: so `kratos bootcheck` can snapshot/verify TPM PCRs rather than
# silently skipping them when the tooling is absent (finding R6-38).
tpm2-tools
gnupg
xz-utils
python3
python3-pyqt6

# ── OpSec tools ──────────────────────────────────────────────────
mat2
secure-delete
diceware
pwgen

