#!/usr/sbin/nft -f
# KratosOS mode: vpn-tor (you -> VPN -> Tor -> internet)
#
# Like `tor` mode, but the tor daemon may only use the WireGuard tunnel. Your
# ISP sees only encrypted WireGuard traffic to the VPN, and the VPN sees only
# Tor traffic, never your destinations.

include "/run/kratos/vpn.nft"

define TOR_UID = "debian-tor"
define TRANS_PORT = 9040
define DNS_PORT = 5353
define TOR_VIRT = 10.192.0.0/10

table inet kratos
delete table inet kratos

table inet kratos {
    chain nat_output {
        type nat hook output priority -100; policy accept;

        # Tor's own connections go out untouched
        meta skuid $TOR_UID return

        # All DNS (including to 127.0.0.1:53) goes to Tor's resolver
        meta nfproto ipv4 meta l4proto { tcp, udp } th dport 53 redirect to :$DNS_PORT
        # .onion addresses mapped by Tor
        ip daddr $TOR_VIRT meta l4proto tcp redirect to :$TRANS_PORT
        # Local services stay local
        oifname "lo" return
        # Every other new TCP connection goes into Tor
        meta nfproto ipv4 tcp flags & (fin|syn|rst|ack) == syn redirect to :$TRANS_PORT
    }

    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state established,related accept
        ct state invalid drop
        udp sport 67 udp dport 68 accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy drop;

        ct state invalid drop
        oifname "lo" accept
        meta nfproto ipv6 drop

        # DHCP
        udp sport 68 udp dport 67 accept
        # WireGuard is a kernel-level sender; allow only its packets to the endpoint
        ip daddr $WG_ENDPOINT udp dport $WG_PORT accept
        # Tor may only talk through the tunnel
        oifname $WG_IF meta skuid $TOR_UID accept
        oifname $WG_IF ct state established,related accept

        meta l4proto tcp reject with tcp reset
        reject
    }
}
