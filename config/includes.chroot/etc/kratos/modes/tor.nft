#!/usr/sbin/nft -f
# KratosOS mode: tor (default)
#
# Every TCP connection is transparently redirected into Tor's TransPort and
# every DNS query into Tor's DNSPort. Only the tor daemon itself may send
# packets to the network. Everything else (UDP, ICMP, raw sockets) is dropped.

define TOR_UID = "debian-tor"
define TRANS_PORT = 9040
define DNS_PORT = 5353
# Tor's VirtualAddrNetworkIPv4, used for .onion addresses
define TOR_VIRT = 10.192.0.0/10

table inet kratos
delete table inet kratos

table inet kratos {
    chain nat_output {
        type nat hook output priority -100; policy accept;

        # Tor's own connections go out untouched
        meta skuid $TOR_UID return

        # All DNS (including to 127.0.0.1:53) goes to Tor's resolver
        meta nfproto ipv4 meta l4proto { tcp, udp } th dport 53 redirect to :$DNS_PORT
        # .onion addresses mapped by Tor
        ip daddr $TOR_VIRT meta l4proto tcp redirect to :$TRANS_PORT
        # Local services stay local
        oifname "lo" return
        # Every other new TCP connection goes into Tor
        meta nfproto ipv4 tcp flags & (fin|syn|rst|ack) == syn redirect to :$TRANS_PORT
    }

    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state established,related accept
        ct state invalid drop
        # DHCP replies
        udp sport 67 udp dport 68 accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy drop;

        ct state invalid drop
        # Redirected flows are now destined for 127.0.0.1
        oifname "lo" accept
        # DHCP, to join the network (the hostname isn't sent, see NetworkManager config)
        udp sport 68 udp dport 67 accept
        # Only Tor itself reaches the network, and only over IPv4 TCP
        meta skuid $TOR_UID meta nfproto ipv4 meta l4proto tcp accept

        # Anything else is a leak attempt: refuse it quickly so apps fail fast
        meta l4proto tcp reject with tcp reset
        reject
    }
}
