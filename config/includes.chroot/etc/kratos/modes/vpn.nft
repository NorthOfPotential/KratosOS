#!/usr/sbin/nft -f
# KratosOS mode: vpn (WireGuard kill switch)
#
# All traffic leaves through the WireGuard interface. The only packets allowed
# on the physical interface are WireGuard UDP packets to the VPN endpoint.
# DHCP is allowed so the machine can join the local network.
#
# /run/kratos/vpn.nft is generated by `kratos mode vpn` from the WireGuard
# config and defines WG_IF, WG_ENDPOINT and WG_PORT.

include "/run/kratos/vpn.nft"

table inet kratos
delete table inet kratos

table inet kratos {
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state established,related accept
        udp sport 67 udp dport 68 accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy drop;
        oifname "lo" accept
        meta nfproto ipv6 drop

        # DHCP to join the network
        udp sport 68 udp dport 67 accept
        # Encrypted tunnel packets to the VPN server only
        ip daddr $WG_ENDPOINT udp dport $WG_PORT accept
        # Everything else must go through the tunnel
        oifname $WG_IF accept

        reject
    }
}
