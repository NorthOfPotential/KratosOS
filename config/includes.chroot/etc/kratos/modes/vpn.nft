#!/usr/sbin/nft -f
# KratosOS network mode: vpn (WireGuard with kill switch)
#
# All traffic, including Stealth Mode's Gateway VM, leaves through the
# WireGuard tunnel. On the physical interface only DHCP and encrypted
# WireGuard packets to the VPN server are allowed. If the tunnel drops,
# nothing gets out.
#
# /run/kratos/vpn.nft is written by `kratos mode vpn` and defines
# WG_IF, WG_ENDPOINT and WG_PORT.

include "/run/kratos/vpn.nft"

define STEALTH_MARK = 0x4b52

table inet kratos
delete table inet kratos

table inet kratos {
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state established,related accept
        ct state invalid drop
        udp sport 67 udp dport 68 accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        # Stealth Gateway traffic may only leave through the tunnel
        meta mark $STEALTH_MARK oifname $WG_IF accept
        meta mark $STEALTH_MARK iifname $WG_IF ct state established,related accept
    }

    chain output {
        type filter hook output priority filter; policy drop;
        oifname "lo" accept
        ct state invalid drop
        meta nfproto ipv6 drop

        udp sport 68 udp dport 67 accept
        # The WireGuard handshake/keepalive to the VPN server — restricted to
        # packets WireGuard itself marks with WG_FWMARK (finding R8-8, now
        # closed). A non-root process cannot set SO_MARK, so it can no longer
        # send arbitrary UDP to the endpoint IP:port outside the tunnel; only
        # WireGuard-originated encrypted traffic matches.
        meta mark $WG_FWMARK ip daddr $WG_ENDPOINT udp dport $WG_PORT accept
        # DNS to the VPN's OWN resolver, only INSIDE the tunnel, is allowed so
        # name resolution works in VPN mode (finding R8-7); it rides the
        # encrypted tunnel to the trusted resolver, never the clear NIC.
        oifname $WG_IF ip daddr $WG_DNS udp dport 53 accept
        oifname $WG_IF ip daddr $WG_DNS tcp dport 53 accept
        # Block all OTHER DNS (to any other address / off the tunnel): apps
        # can't exfiltrate via DNS to arbitrary servers.
        udp dport 53 oifname != "lo" drop
        tcp dport 53 oifname != "lo" drop
        oifname $WG_IF accept
        # Replies to the stealth bridges (no new host-initiated connections)
        oifname { "kx-ext", "kx-int" } ct state established,related accept

        reject
    }
}
