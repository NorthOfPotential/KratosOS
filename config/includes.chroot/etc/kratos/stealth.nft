#!/usr/sbin/nft -f
# KratosOS Stealth Mode firewall. Loaded while Stealth Mode is on, removed
# when it's off.
#
#   kx-int  Workstation <-> Gateway only. Never forwarded, never reaches host.
#   kx-ext  Gateway <-> outside. Forwarded traffic gets STEALTH_MARK; the
#           active network-mode table (normal/vpn/offline) decides where
#           marked traffic may go. In vpn mode that's the tunnel only.
#
# This chain runs before the mode table (priority filter - 10). Its drops
# are final; its marks are what the mode table accepts.

define STEALTH_MARK = 0x4b52

table inet kratos_stealth
delete table inet kratos_stealth

table inet kratos_stealth {
    chain forward {
        type filter hook forward priority filter - 10; policy accept;
        iifname "kx-int" drop
        oifname "kx-int" drop
        iifname "kx-ext" oifname != "kx-ext" meta mark set $STEALTH_MARK
        oifname "kx-ext" ct state established,related meta mark set $STEALTH_MARK
    }

    chain input {
        type filter hook input priority filter - 10; policy accept;
        # The VMs can't talk to services on the host
        iifname { "kx-ext", "kx-int" } drop
    }

    chain output {
        type filter hook output priority filter - 10; policy accept;
        # Only constrain what the HOST sends TOWARD the VM networks; everything
        # else leaves normally.
        oifname != { "kx-ext", "kx-int" } accept
        # Replies to traffic the VMs started are fine.
        ct state established,related accept
        # The host runs DHCP for the guest networks (dnsmasq on the bridge):
        # allow server->client offers/acks, nothing more.
        udp sport 67 udp dport 68 accept
        # Anything else the host tries to INITIATE toward the VMs is dropped: a
        # compromised host process must not be able to reach the persona VMs or
        # inject into their networks. The VMs' only path out is the forwarded,
        # marked kx-ext traffic the mode table governs — not host-originated.
        drop
    }
}
