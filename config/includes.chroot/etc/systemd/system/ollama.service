# KratosOS: local Ollama model server. Shipped DISABLED; 'kratos-ai setup'
# installs the runtime and enables this. Bound to loopback — never listens on
# the network.
[Unit]
Description=Ollama local model server (KratosOS AI)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/bin/ollama

[Service]
Type=exec
User=ollama
Group=ollama
# GPU access when a driver is present (harmless on CPU-only machines).
SupplementaryGroups=render video
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=HOME=/var/lib/kratos/ai/models
Environment=OLLAMA_MODELS=/var/lib/kratos/ai/models
# Tamper gate: verify the binary still matches the hash recorded when it was
# verified at install; fail closed on a mismatch. '+' runs it as root so it can
# read the root-owned baseline, regardless of User=ollama.
ExecStartPre=+/usr/local/bin/kratos-ai verify-ollama
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=3
# Hardening: read-only system, writes confined to the model store, no new privs.
# (No PrivateDevices — the daemon needs /dev/nvidia*,/dev/dri for GPU offload.)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The parent stores a root-owned integrity baseline and model selection;
# only the per-model subtree is writable to this service.
ReadWritePaths=/var/lib/kratos/ai/models
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
