[Unit]
Description=KratosOS firewall (loaded before any network interface comes up)
DefaultDependencies=no
Before=network-pre.target libvirtd.service
Wants=network-pre.target
After=local-fs.target
# Order AFTER systemd-rfkill's state restore (finding R12-2), so when this unit
# applies the early offline radio block (saved mode = offline) systemd-rfkill
# can't then re-unblock from its saved state. Ordering only; we don't pull it in.
After=systemd-rfkill.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Two layers, fail-closed (finding 6):
#  1. a minimal default-drop (offline.nft: loopback only) loads FIRST, so if the
#     full ruleset below fails to load the machine stays blocked, not open;
#  2. the mode manager (kratos boot) then installs the real policy.
# NetworkManager Requires= this unit (NetworkManager.service.d drop-in), so if
# EITHER step fails the unit fails and networking never comes up at all.
ExecStartPre=/usr/sbin/nft -f /etc/kratos/modes/offline.nft
ExecStart=/usr/local/bin/kratos boot

[Install]
WantedBy=sysinit.target
