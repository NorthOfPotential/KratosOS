{
  "policies": {
    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "DisableFeedbackCommands": true,
    "DisableFormHistory": true,
    "DontCheckDefaultBrowser": true,
    "OverrideFirstRunPage": "",
    "HttpsOnlyMode": "force_enabled",
    "DNSOverHTTPS": { "Enabled": false, "Locked": true },
    "EnableTrackingProtection": {
      "Value": true, "Locked": true,
      "Cryptomining": true, "Fingerprinting": true, "EmailTracking": true
    },
    "Cookies": { "Behavior": "reject-tracker-and-partition-foreign" },
    "FirefoxHome": { "SponsoredTopSites": false, "SponsoredPocket": false, "Pocket": false, "Locked": true },
    "FirefoxSuggest": { "SponsoredSuggestions": false, "ImproveSuggest": false, "Locked": true },
    "UserMessaging": { "ExtensionRecommendations": false, "FeatureRecommendations": false, "SkipOnboarding": true },
    "SearchEngines": { "Default": "DuckDuckGo" },
    "OfferToSaveLogins": false,
    "PasswordManagerEnabled": false,
    "ExtensionSettings": {
      "uBlock0@raymondhill.net": {
        "installation_mode": "normal_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi"
      }
    },
    "Preferences": {
      "browser.contentblocking.category": { "Value": "strict", "Status": "default" },
      "media.peerconnection.ice.default_address_only": { "Value": true, "Status": "locked" },
      "media.peerconnection.ice.no_host": { "Value": true, "Status": "locked" },
      "network.prefetch-next": { "Value": false, "Status": "locked" },
      "network.dns.disablePrefetch": { "Value": true, "Status": "locked" },
      "geo.enabled": { "Value": false, "Status": "default" }
    }
  }
}
