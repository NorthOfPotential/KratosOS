#!/bin/sh
# KratosOS privileged helper for the EVERYDAY Stealth controls only: on, off,
# view. These use a RETAINED polkit auth (org.kratos.stealth) for tray
# usability. The DESTRUCTIVE / provisioning actions — setup (parses
# attacker-selected archives, reprovisions the vault) and reset (erases persona
# state) — are deliberately NOT reachable here; they go through
# kratos-stealth-admin with a NON-retained auth (finding R8-16). A caller can
# pass arguments to the chosen subcommand but cannot select another.
case "${1:-}" in
    on|off|view) exec /usr/local/bin/kratos stealth "$@" ;;
    *) echo "kratos-stealth: only on|off|view are allowed here (use kratos-stealth-admin for setup/reset)" >&2; exit 2 ;;
esac
