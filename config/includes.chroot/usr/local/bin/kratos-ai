#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR/../lib/kratos
# kratos-ai — KratosOS local AI coder: a fully-local Ollama + Open WebUI stack
# with an abliterated coder model auto-sized to this machine. Inference runs
# entirely on-device; the only network use is the one-time runtime+model
# download (and optional web search). Works offline once provisioned.
set -euo pipefail

# System directories FIRST: firecfg puts firejail wrapper symlinks in
# /usr/local/bin (sha256sum, wget, clamscan, ssh, ...). Searched first, root
# ran those through firejail, which broke `kratos bootcheck` (firejail refuses
# >128 arguments) and silently changed what root executes. /usr/local stays
# on PATH, last, only for programs nothing else provides.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/sbin:/usr/local/bin
unset BASH_ENV ENV CDPATH GLOBIGNORE IFS \
      LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT PYTHONPATH PYTHONSTARTUP PYTHONHOME 2>/dev/null || true

# Production entry points must never source caller-selected privileged code.
# The main 'kratos' CLI already enforces this; apply the same safeguard to
# kratos-ai, including its systemd root ExecStartPre integrity verifier.
_self="$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")"
if [[ "$_self" == /usr/local/bin/kratos-ai ]]; then
    unset KRATOS_LIB AI_HOME AI_VENV AI_STATE OLLAMA_BIN OLLAMA_SHA_BASELINE \
          OLLAMA_HOST WEBUI_HOST WEBUI_PORT \
          KRATOS_AI_TORCH_CPU_INDEX KRATOS_AI_SKIP_SPACE_CHECK KRATOS_AI_LOCK_DIR
fi
unset _self

KRATOS_LIB="${KRATOS_LIB:-/usr/local/lib/kratos}"
# shellcheck source=common.sh
. "$KRATOS_LIB/common.sh"
# shellcheck source=ai.sh
. "$KRATOS_LIB/ai.sh"

PROVISIONED_MARK="$AI_STATE/provisioned"

# Separate trusted control state from model data writable by the daemon.
# /var/lib/kratos/ai MUST be root-owned: previously it was owned by ollama,
# allowing that service to plant symlinks under root-written paths
# (ollama.sha256 and model). This is a local privilege/availability boundary.
prepare_ai_state() {
    [[ ! -L "$AI_STATE" ]] || die "AI state directory is a symlink; refusing to use it"
    install -d -m 755 -o root -g root "$AI_STATE"
    _is_root_owned_secure "$AI_STATE" || die "AI state directory must be root-owned and non-writable by others"
    [[ ! -L "$AI_STATE/models" ]] || die "AI model directory is a symlink; refusing to use it"
    install -d -m 750 -o ollama -g ollama "$AI_STATE/models"
}

# Atomic replace, never a redirection through an untrusted existing pathname.
# Both files stay root-owned and cannot be replaced by the ollama account.
save_ai_control_file() {
    local dest="$1" value="$2" mode="$3" tmp
    tmp="$(mktemp "$AI_STATE/.control.XXXXXXXX")" || die "cannot create AI control-file staging"
    printf '%s\n' "$value" > "$tmp"
    chmod "$mode" "$tmp"
    mv -Tf -- "$tmp" "$dest" || die "cannot publish AI control file"
}

need_root() { [[ "$(id -u)" -eq 0 ]] || die "this needs root: run 'sudo kratos-ai $1'"; }

# Tamper gate: the installed Ollama binary must still match the hash we recorded
# when we VERIFIED it at install. Run as ExecStartPre (fail-closed) and on demand.
verify_ollama() {
    [[ -x "$OLLAMA_BIN" ]] || { err "ollama binary missing ($OLLAMA_BIN)"; exit 1; }
    [[ -f "$OLLAMA_SHA_BASELINE" && ! -L "$OLLAMA_SHA_BASELINE" ]] \
        || { err "no safe integrity baseline — run: sudo kratos-ai setup"; return 1; }
    if ! _is_root_owned_secure "$AI_STATE" || ! _is_root_owned_secure "$OLLAMA_SHA_BASELINE"; then
        err "AI integrity baseline or parent is not securely root-owned"
        return 1
    fi
    local want got; want="$(cat "$OLLAMA_SHA_BASELINE")"; got="$(sha256sum "$OLLAMA_BIN" | awk '{print $1}')"
    if [[ "$got" != "$want" ]]; then
        err "INTEGRITY FAILURE: $OLLAMA_BIN changed since install (recorded $want, now $got). Refusing to run."
        err "If you deliberately updated Ollama, re-baseline with: sudo kratos-ai setup"
        return 1
    fi
}

require_network() {
    # Local inference needs no network, but provisioning and web search do.
    if ! curl -fsS --connect-timeout 8 -o /dev/null "https://ollama.com" 2>/dev/null; then
        die "no network (or KratosOS is in offline mode). Switch first: sudo kratos mode normal"
    fi
}

install_ollama() {
    # Migrate even an already-provisioned installation away from the old
    # daemon-owned control directory before attempting any root file writes.
    getent group ollama >/dev/null || groupadd --system ollama
    getent passwd ollama >/dev/null || useradd --system --home-dir "$AI_STATE/models" --shell /usr/sbin/nologin -g ollama ollama
    prepare_ai_state
    if [[ -x "$OLLAMA_BIN" ]]; then
        verify_ollama || die "existing Ollama binary failed integrity verification"
        # An intact but OUTDATED binary is still vulnerable. Earlier builds
        # pinned 0.30.10, including versions affected by path traversal/SSRF.
        local installed_version
        installed_version="$("$OLLAMA_BIN" --version 2>/dev/null || true)"
        if [[ "$installed_version" == *"ollama version is ${KRATOS_AI_OLLAMA_VERSION#v}"* ]]; then
            ok "Ollama already installed ($installed_version)"
            return
        fi
        warn "Ollama needs a security upgrade ($installed_version -> $KRATOS_AI_OLLAMA_VERSION)"
        systemctl stop ollama.service >/dev/null 2>&1 || true
    fi
    require_network
    ai_require_free /usr/local 3 "the Ollama runtime"
    info "Installing or updating the Ollama runtime ($KRATOS_AI_OLLAMA_VERSION)..."
    need_cmd zstd tar python3
    # A RETURN trap stays set after this function returns and fires again when
    # the caller returns, where the local $tmp no longer exists: under set -u
    # that ended `kratos-ai setup` with "tmp: unbound variable" and exit 1 after
    # a successful setup (VM test). Expand the path now and clear the trap once
    # it has run.
    local tmp; tmp="$(mktemp -d)"
    # shellcheck disable=SC2064  # expand $tmp now, at trap-set time
    trap "rm -rf -- '$tmp'; trap - RETURN" RETURN
    local tarball="$tmp/ollama.tar.zst" asset; asset="${KRATOS_AI_OLLAMA_URL##*/}"
    [[ "$asset" == *.tar.zst ]] || die "unsupported Ollama archive; require .tar.zst"
    curl -fL --proto "=https" --tlsv1.2 --connect-timeout 30 "$KRATOS_AI_OLLAMA_URL" -o "$tarball" \
        || die "could not download the Ollama runtime"

    # INTEGRITY: never extract an unverified archive as root. Prefer a baked
    # pin; else verify against the release's sha256sum.txt (same pinned HTTPS
    # origin). Fail closed if neither is available.
    local got want=""; got="$(sha256sum "$tarball" | awk '{print $1}')"
    if [[ -n "$KRATOS_AI_OLLAMA_SHA256" ]]; then
        want="$KRATOS_AI_OLLAMA_SHA256"
    elif curl -fL --proto "=https" --tlsv1.2 --connect-timeout 30 \
            "${KRATOS_AI_OLLAMA_URL%/*}/sha256sum.txt" -o "$tmp/sums" 2>/dev/null; then
        want="$(awk -v f="$asset" '{n=$2; sub(/^[*]/,"",n); sub(/^\.\//,"",n); if(n==f) print $1}' "$tmp/sums" | head -n1)"
    fi
    [[ -n "$want" ]] || die "cannot verify the Ollama download (no checksum). Pin it: sudo KRATOS_AI_OLLAMA_SHA256=<hex> kratos-ai setup"
    [[ "${got,,}" == "${want,,}" ]] || die "Ollama download FAILED checksum (got $got, want $want) — refusing to install"
    ok "Ollama download verified (sha256)"

    # Validate all member names, types and symlink targets before root extraction.
    # Unlike tar -tzf | grep -q, this reads the entire archive and fails closed.
    python3 "$KRATOS_LIB/check-ollama-archive.py" "$tarball" \
        || die "Ollama archive contains unsafe members — refusing to extract"
    install -d -m 755 /usr/local
    tar --zstd -xf "$tarball" -C /usr/local --no-same-owner --no-same-permissions \
        || die "could not unpack the Ollama runtime"
    [[ -x "$OLLAMA_BIN" ]] || die "Ollama binary not found after install ($OLLAMA_BIN)"
    # The daemon cannot write $AI_STATE or the root-owned hash; it can only
    # write into $AI_STATE/models. Replace the hash atomically as root.
    save_ai_control_file "$OLLAMA_SHA_BASELINE" "$(sha256sum "$OLLAMA_BIN" | awk '{print $1}')" 600
    systemctl daemon-reload
    ok "Ollama installed and integrity baseline recorded"
}

# Open WebUI requires Python 3.11/3.12 (requires-python "<3.13"), but Debian 13
# ships only 3.13, so on KratosOS there is no usable system interpreter. We
# provision an APP-PRIVATE CPython 3.12 with uv: uv is installed from PyPI as a
# single hash-pinned wheel (pip --require-hashes refuses anything else), and uv
# verifies the interpreter download against the SHA256s embedded in that pinned
# uv release. Everything runs as the unprivileged kratos-ai account; the result
# is then made root-owned and read-only so the service cannot alter its own
# interpreter. Bump these three together.
UV_VERSION="0.13.7"
UV_WHEEL_SHA256="2c9bdc4a872b60a93c5f26c0791089ea11585a4f9d3b3c017d78eb8487505e25"
UV_PYTHON="3.12"

# Echoes the path of the provisioned python3.12 on stdout; all logs to stderr.
provision_python312() {
    local boot="$AI_HOME/.uv-bootstrap" pydir="$AI_HOME/python" py
    [[ ! -L "$boot" && ! -L "$pydir" ]] || die "uv bootstrap/python dir is an unsafe symlink"
    rm -rf -- "$boot" "$pydir"
    install -d -m 750 -o kratos-ai -g kratos-ai "$boot" "$pydir"
    printf 'uv==%s --hash=sha256:%s\n' "$UV_VERSION" "$UV_WHEEL_SHA256" > "$boot/requirements.txt"
    chown kratos-ai:kratos-ai "$boot/requirements.txt"
    local -a uvenv=(env HOME="$boot" XDG_CACHE_HOME="$boot/cache" UV_NO_CONFIG=1
                    UV_PYTHON_INSTALL_DIR="$pydir" UV_PYTHON_BIN_DIR="$boot/bin")
    info "Provisioning an app-private Python $UV_PYTHON for Open WebUI (Debian 13 ships only 3.13)..." >&2
    runuser -u kratos-ai -- python3 -m venv "$boot/venv" >&2 || return 1
    runuser -u kratos-ai -- "$boot/venv/bin/pip" install --quiet --no-cache-dir --require-hashes --no-deps \
        --only-binary=:all: -r "$boot/requirements.txt" >&2 || return 1
    runuser -u kratos-ai -- "${uvenv[@]}" "$boot/venv/bin/uv" python install "$UV_PYTHON" >&2 || return 1
    py="$(runuser -u kratos-ai -- "${uvenv[@]}" "$boot/venv/bin/uv" python find \
            --python-preference only-managed "$UV_PYTHON")" || return 1
    [[ "$py" == "$pydir"/* && -x "$py" ]] || { err "uv returned an unexpected interpreter: $py"; return 1; }
    rm -rf -- "$boot"                       # uv is no longer needed
    # root-owned + read/exec for the service account, but never writable by it
    chown -R root:root "$pydir"; chmod -R go-w,go+rX "$pydir"
    printf '%s\n' "$py"
}

# Read distribution metadata with the SYSTEM Python in isolated mode rather
# than executing potentially service-controlled venv scripts as root.
installed_webui_version() {
    python3 -I - "$AI_VENV" <<'PY'
from importlib import metadata
from pathlib import Path
import sys
for site in Path(sys.argv[1]).glob("lib/python*/site-packages"):
    for dist in metadata.distributions(path=[str(site)]):
        if (dist.metadata.get("Name", "").lower().replace("-", "_") == "open_webui"):
            print(dist.version)
            raise SystemExit(0)
PY
}

setup_webui() {
    need_cmd python3
    # Pinned to the newest release. 0.12.3, 0.12.4, 0.12.5, 0.13.0 and 0.13.1 each ship
    # undisclosed security fixes upstream says to apply ASAP, so older pins are known
    # vulnerable. Versionless 'pip install open-webui' plus "already installed"
    # bypassed upgrades entirely, leaving installations on vulnerable versions.
    local webui_version="0.13.1" installed
    getent group kratos-ai >/dev/null || groupadd --system kratos-ai
    getent passwd kratos-ai >/dev/null || useradd --system --home-dir "$AI_HOME" --shell /usr/sbin/nologin -g kratos-ai kratos-ai
    [[ ! -L "$AI_HOME" ]] || die "AI home is an unsafe symlink"
    install -d -m 755 -o root -g root "$AI_HOME"
    [[ ! -L "$AI_VENV" && ! -L "$AI_HOME/data" ]] \
        || die "AI venv/data contains an unsafe symlink"
    install -d -m 750 -o kratos-ai -g kratos-ai "$AI_HOME/data"
    installed="$(installed_webui_version)"
    # Only a fully root-owned venv can be reused; prior versions let the
    # daemon edit its own code, so simply chowning it would bless implants.
    if [[ -x "$AI_VENV/bin/open-webui" && "$installed" == "$webui_version" ]] \
       && [[ "$(stat -c '%u' "$AI_VENV")" == 0 ]] \
       && [[ -z "$(find "$AI_VENV" -xdev ! -uid 0 -print -quit)" ]] \
       && [[ ! -e "$AI_HOME/python" || -z "$(find "$AI_HOME/python" -xdev ! -uid 0 -print -quit)" ]]; then
        chmod -R go-w,go+rX "$AI_VENV"
        ok "Open WebUI $webui_version already installed (root-owned code)"
        return
    fi
    # Open WebUI supports Python 3.11/3.12 only, and the dependency locks are
    # resolved for 3.12 (their wheels are cp312). Never force an unsupported
    # interpreter or silently install an old vulnerable WebUI: use a system
    # 3.12 if there is one; otherwise (the normal case on Debian 13, which
    # ships only 3.13) provision a hash-verified app-private 3.12 with uv.
    require_network
    local lock extra_index=()
    local python_cmd="" candidate version
    for candidate in python3.12 python3; do
        command -v "$candidate" >/dev/null 2>&1 || continue
        version="$("$candidate" -c 'import sys;print("%d.%d"%sys.version_info[:2])')" || continue
        if [[ "$version" == 3.12 ]]; then
            python_cmd="$(command -v "$candidate")"
            break
        fi
    done
    if [[ -z "$python_cmd" ]]; then
        python_cmd="$(provision_python312)" \
            || die "could not provision Python $UV_PYTHON for Open WebUI (it needs 3.12; Debian 13 ships 3.13)"
    fi
    info "Installing patched Open WebUI $webui_version with unprivileged pip..."
    systemctl stop kratos-openwebui.service >/dev/null 2>&1 || true
    rm -rf -- "$AI_VENV"
    local gpu_vendor _vram; read -r gpu_vendor _vram < <(ai_gpu_info)
    ai_require_free "$AI_HOME" "$(ai_webui_disk_gb "$gpu_vendor")" "Open WebUI"
    install -d -m 750 -o kratos-ai -g kratos-ai "$AI_VENV"
    runuser -u kratos-ai -- "$python_cmd" -m venv "$AI_VENV" || die "could not create the Open WebUI virtualenv"
    # Every package is installed from a hash-pinned lock (tools/lock-openwebui.sh):
    # one exact version per package, and pip refuses any file whose SHA256 isn't
    # in the lock, so a library swapped on PyPI can't get in. Wheels only (an
    # sdist build would fetch unpinned build tools), no dependency resolution
    # (the lock is complete), and no self-upgrade of pip (that was unpinned).
    # Open WebUI's embedding stack needs PyTorch. The default PyPI build
    # bundles ~5 GB of NVIDIA CUDA libraries that only an NVIDIA GPU can use
    # (VM test: it filled a 21 GB root), so without one the CPU lock pins
    # PyTorch's official CPU-only build, found on PyTorch's own index; its
    # hash in the lock is what makes that second index safe to use.
    # (Inference itself runs in Ollama, which has its own GPU support.)
    if [[ "$gpu_vendor" == nvidia ]]; then
        lock="$KRATOS_AI_LOCK_DIR/openwebui-nvidia.lock"
    else
        lock="$KRATOS_AI_LOCK_DIR/openwebui-cpu.lock"
        extra_index=(--extra-index-url "$KRATOS_AI_TORCH_CPU_INDEX")
        info "No NVIDIA GPU: using the CPU-only PyTorch build (no CUDA libraries)..."
    fi
    [[ -f "$lock" && ! -L "$lock" ]] || die "dependency lock missing: $lock"
    grep -qxF "open-webui==$webui_version \\" "$lock" \
        || die "$lock does not pin open-webui==$webui_version (regenerate it: tools/lock-openwebui.sh)"
    runuser -u kratos-ai -- "$AI_VENV/bin/pip" install --no-cache-dir --require-hashes --no-deps \
        --only-binary=:all: "${extra_index[@]}" -r "$lock" \
        || die "could not install Open WebUI from the hash-pinned lock $lock"
    installed="$(installed_webui_version)"
    [[ "$installed" == "$webui_version" ]] \
        || die "Open WebUI version mismatch after install (found $installed; want $webui_version)"
    # Root-owned and not writable by the service, but READABLE/traversable: the
    # venv was created 750 kratos-ai, and chown to root alone would leave it
    # 750 root:root, which the kratos-ai service could not even enter.
    chown -R root:root "$AI_VENV"
    chmod -R go-w,go+rX "$AI_VENV"
    ok "Open WebUI $webui_version installed (unprivileged build, immutable code)"
}

pull_model() {
    local budget model label
    budget="$(ai_budget_gb)"; read -r model label < <(ai_pick_model "$budget")
    systemctl enable --now ollama.service >/dev/null 2>&1 || true
    # Wait for the daemon socket.
    local n=0; while (( n++ < 30 )); do curl -fsS -o /dev/null "http://$OLLAMA_HOST/api/version" 2>/dev/null && break; sleep 1; done
    if ! OLLAMA_HOST="$OLLAMA_HOST" "$OLLAMA_BIN" list 2>/dev/null | awk 'NR>1 {print $1}' | grep -qxF "$model"; then
        ai_require_free "$AI_STATE/models" "$(ai_model_disk_gb "$model")" "the $model model"
    fi
    info "Pulling model: $model  ($label) — sized to ~${budget} GB budget. This is large; one time."
    OLLAMA_HOST="$OLLAMA_HOST" "$OLLAMA_BIN" pull "$model" || die "could not pull $model (check connection, or set KRATOS_AI_MODEL)"
    save_ai_control_file "$AI_STATE/model" "$model" 644
    ok "Model ready: $model"
}

cmd_setup() {
    need_root setup
    # Work from a neutral directory. The unprivileged steps (runuser -u
    # kratos-ai ...) inherit our cwd, usually the invoking user's home, which
    # the service account cannot read: `uv python find` probes ./.venv there
    # and failed with "Permission denied", aborting setup (VM test).
    cd / || die "cannot change to /"
    info "== KratosOS local AI setup =="
    ai_report_hardware
    install_ollama
    pull_model
    setup_webui
    systemctl enable --now kratos-openwebui.service >/dev/null 2>&1 || warn "Open WebUI service did not start; check: journalctl -u kratos-openwebui"
    touch "$PROVISIONED_MARK"
    ok "Done. Open the assistant with:  kratos-ai ui   (or the 'Kratos AI' app)"
    info "  UI: http://$WEBUI_HOST:$WEBUI_PORT"
}

cmd_status() {
    ai_report_hardware
    echo
    info "Services:"
    local s
    for s in ollama kratos-openwebui; do
        if systemctl is-active --quiet "$s" 2>/dev/null; then ok "$s: active"; else warn "$s: not running"; fi
    done
    if [[ -f "$PROVISIONED_MARK" ]]; then ok "provisioned"; else warn "not provisioned yet — run: sudo kratos-ai setup"; fi
    [[ -f "$AI_STATE/model" ]] && ok "active model: $(cat "$AI_STATE/model")"
}

cmd_ui() {
    if [[ ! -f "$PROVISIONED_MARK" ]]; then
        warn "The AI assistant isn't set up yet."
        info "Run once:  sudo kratos-ai setup"
        exit 1
    fi
    systemctl is-active --quiet kratos-openwebui 2>/dev/null || { need_root ui; systemctl start kratos-openwebui; }
    local url="http://$WEBUI_HOST:$WEBUI_PORT"
    info "Opening $url"
    command -v xdg-open >/dev/null 2>&1 && exec xdg-open "$url" >/dev/null 2>&1
    info "Open your browser at: $url"
}

cmd_model() {
    case "${1:-}" in
        list) "$OLLAMA_BIN" list ;;
        pull) [[ -n "${2:-}" ]] || die "usage: kratos-ai model pull <ollama-tag>"; need_root "model pull $2"; "$OLLAMA_BIN" pull "$2" ;;
        use)  [[ -n "${2:-}" ]] || die "usage: kratos-ai model use <ollama-tag>"; need_root "model use $2"; prepare_ai_state; save_ai_control_file "$AI_STATE/model" "$2" 644; ok "default model set to $2 (select it in the UI)" ;;
        *)    die "usage: kratos-ai model {list|pull <tag>|use <tag>}" ;;
    esac
}

usage() {
    cat <<EOF
${BOLD}kratos-ai${RESET} — a fully-local AI coder (Ollama + Open WebUI), auto-sized to your machine.
Inference runs 100% on-device; only setup (and optional web search) use the network.

  setup            Detect hardware, install the runtime, download the best-fit
                   abliterated coder model, and start the UI.  (needs sudo)
  ui               Open the assistant in your browser.
  status           Show detected hardware, chosen model, and service state.
  detect           Show hardware detection + which model would be chosen.
  start | stop     Start/stop the local AI services.
  model list       List installed models.
  model pull <tag> Download another Ollama model.
  model use <tag>  Set the default model.
  verify           Re-check the Ollama runtime against the hash recorded at
                   install (tamper detection). The service also does this on
                   every start and refuses to run on a mismatch.

Notes:
  * NPUs are detected but NOT yet usable for inference on Linux; GPU (CUDA/ROCm/
    Vulkan) is used when present, otherwise CPU + RAM.
  * Override the model with  KRATOS_AI_MODEL=<ollama-tag>  before 'setup'.
EOF
}

case "${1:-help}" in
    setup)   cmd_setup ;;
    status)  cmd_status ;;
    detect)  ai_report_hardware ;;
    ui)      cmd_ui ;;
    start)   need_root start; systemctl start ollama.service kratos-openwebui.service; ok "started" ;;
    stop)    need_root stop;  systemctl stop  kratos-openwebui.service ollama.service; ok "stopped" ;;
    model)   shift; cmd_model "$@" ;;
    verify)         verify_ollama && ok "Ollama runtime integrity OK (matches the hash recorded at install)" ;;
    verify-ollama)  verify_ollama ;;   # fail-closed gate used by ollama.service ExecStartPre
    help|-h|--help) usage ;;
    *) err "unknown command: $1"; echo; usage; exit 1 ;;
esac
