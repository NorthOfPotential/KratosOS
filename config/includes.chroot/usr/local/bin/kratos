#!/usr/bin/env bash
# kratos - KratosOS privacy & OpSec control tool
set -euo pipefail

KRATOS_LIB="${KRATOS_LIB:-/usr/local/lib/kratos}"

# shellcheck source=../lib/kratos/common.sh
. "$KRATOS_LIB/common.sh"
# shellcheck source=../lib/kratos/net.sh
. "$KRATOS_LIB/net.sh"
# shellcheck source=../lib/kratos/opsec.sh
. "$KRATOS_LIB/opsec.sh"
# shellcheck source=../lib/kratos/vm.sh
. "$KRATOS_LIB/vm.sh"
# shellcheck source=../lib/kratos/migrate.sh
. "$KRATOS_LIB/migrate.sh"

usage() {
    cat <<EOF
${BOLD}kratos${RESET} - KratosOS privacy & OpSec control

${BOLD}Network${RESET}
  status                 Show network mode, firewall, Tor and VPN state
  check                  Run a full leak test (Tor, DNS, IPv6, ICMP, MAC, clock)
  mode <m>               Switch mode: tor | vpn-tor | vpn | offline (fail-closed)
  newnym                 New Tor circuits (new exit IP for new connections)
  vpn-import <file>      Install a WireGuard config for vpn / vpn-tor modes
  mac                    Show current vs hardware MAC addresses

${BOLD}OpSec${RESET}
  scrub [--show] <files> Remove metadata (EXIF, GPS, author, ...) with mat2
  shred <files>          Overwrite and delete files
  scan [path]            Malware and rootkit scan (ClamAV + rkhunter)
  usb [allow <id>]       List USB devices or allow a blocked one (USBGuard)
  panic                  Cut network, kill sessions, wipe caches, power off NOW

${BOLD}Isolation${RESET}
  vm <image|iso> [opts]  Start a disposable VM networked through Tor
                         (--mem 4G, --cpus 2, --offline, --disk 20G)

${BOLD}Migration${RESET}
  migrate [opts]         Copy user files from a Windows 11 disk
                         (--source /dev/sdXN, --dest DIR, --user NAME, --scrub)

See /usr/share/doc/kratos for the threat model and OpSec guide.
EOF
}

main() {
    local cmd="${1:-help}"
    shift || true
    case "$cmd" in
        status)      net_status "$@" ;;
        check)       net_check "$@" ;;
        mode)        net_mode "$@" ;;
        boot)        net_boot "$@" ;;
        newnym)      net_newnym "$@" ;;
        vpn-import)  net_vpn_import "$@" ;;
        mac)         net_mac "$@" ;;
        scrub)       opsec_scrub "$@" ;;
        shred)       opsec_shred "$@" ;;
        scan)        opsec_scan "$@" ;;
        usb)         opsec_usb "$@" ;;
        panic)       opsec_panic "$@" ;;
        vm)          vm_run "$@" ;;
        migrate)     migrate_windows "$@" ;;
        help|-h|--help) usage ;;
        *) err "unknown command: $cmd"; usage; exit 2 ;;
    esac
}

main "$@"
