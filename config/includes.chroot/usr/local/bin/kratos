#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR/../lib/kratos
# kratos - KratosOS privacy & Stealth Mode control tool
set -euo pipefail

KRATOS_LIB="${KRATOS_LIB:-/usr/local/lib/kratos}"

# shellcheck source=common.sh
. "$KRATOS_LIB/common.sh"
# shellcheck source=net.sh
. "$KRATOS_LIB/net.sh"
# shellcheck source=stealth.sh
. "$KRATOS_LIB/stealth.sh"
# shellcheck source=opsec.sh
. "$KRATOS_LIB/opsec.sh"
# shellcheck source=migrate.sh
. "$KRATOS_LIB/migrate.sh"

usage() {
    cat <<EOF
${BOLD}kratos${RESET} - KratosOS privacy & Stealth Mode control

${BOLD}Stealth Mode${RESET} (isolated Whonix persona environment)
  stealth on             Lock down host, unlock vault, start Gateway + Workstation
  stealth off            Stop Workstation FIRST, then Gateway, wipe, lock, restore
  stealth view [gateway] Open the Workstation (or Gateway) desktop window
  stealth status         Show Stealth Mode state and isolation checks
  stealth setup <file>   Import a signature-verified Whonix KVM download
  stealth reset          Restore the Workstation to a clean image

${BOLD}Network${RESET}
  status                 Network mode, firewall, VPN, DNS, MAC and Stealth state
  mode <m>               normal | vpn | offline (fail-closed switch)
  vpn-import <file>      Install a WireGuard config (e.g. from Proton VPN)
  mac                    Show current vs hardware MAC addresses

${BOLD}OpSec${RESET}
  scrub [--show] <files> Remove metadata (EXIF, GPS, author, ...) with mat2
  shred <files>          Overwrite and delete files
  scan [path]            Malware and rootkit scan (ClamAV + rkhunter)
  usb [allow|block <id>] List USB devices or allow/block one (USBGuard)
  panic                  Kill stealth VMs, lock vault, cut network, power off NOW

${BOLD}Migration${RESET}
  migrate --from <dir|dev> Import files from a Windows export or Windows disk

Docs: /usr/share/doc/kratos
EOF
}

main() {
    local cmd="${1:-help}"
    shift || true
    case "$cmd" in
        stealth)     stealth_main "$@" ;;
        status)      net_status "$@" ;;
        mode)        net_mode "$@" ;;
        boot)        net_boot "$@" ;;
        restore)     net_restore "$@" ;;
        vpn-import)  net_vpn_import "$@" ;;
        mac)         net_mac "$@" ;;
        scrub)       opsec_scrub "$@" ;;
        shred)       opsec_shred "$@" ;;
        scan)        opsec_scan "$@" ;;
        usb)         opsec_usb "$@" ;;
        panic)       opsec_panic "$@" ;;
        migrate)     migrate_windows "$@" ;;
        help|-h|--help) usage ;;
        *) err "unknown command: $cmd"; usage; exit 2 ;;
    esac
}

main "$@"
