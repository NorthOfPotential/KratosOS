#!/bin/sh
# Apply current Debian security updates to the image BEFORE it is packed.
#
# build.sh disables live-build's own security archive (its old suite naming
# 404s), so the base packages installed from 'main' could be behind on security
# fixes. A security distribution must not ship a stale base, so here we add the
# correct 'trixie-security' suite (the same one shipped to the installed system)
# and upgrade. Runs before 0090 (sectools) and 0100, while APT lists exist.
set -e
export DEBIAN_FRONTEND=noninteractive

if ! grep -rqs 'trixie-security' /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null; then
    echo 'deb http://deb.debian.org/debian-security trixie-security main contrib non-free non-free-firmware' \
        > /etc/apt/sources.list.d/kratos-security.list
fi

apt-get update
# full-upgrade (not plain upgrade): security transitions can pull in new or
# changed dependencies, which `upgrade` holds back — a security image must take
# them (finding 12). --force-confold keeps KratosOS's hardened /etc; never let
# an upgrade silently replace our config with a package default.
apt-get -y --no-install-recommends -o Dpkg::Options::=--force-confold full-upgrade

# Fail the build if anything is still upgradeable after the full-upgrade: a
# security image must not ship with known-pending updates.
remaining="$(apt-get -s -o Dpkg::Options::=--force-confold full-upgrade 2>/dev/null \
    | grep -c '^Inst ' || true)"
if [ "${remaining:-0}" -ne 0 ]; then
    echo "KRATOS: ERROR — $remaining package(s) still upgradeable after full-upgrade" >&2
    apt-get -s full-upgrade 2>/dev/null | grep '^Inst ' >&2 || true
    exit 1
fi
echo "KRATOS: applied Debian security updates to the image (full-upgrade; none pending)."
