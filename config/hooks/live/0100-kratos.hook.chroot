#!/bin/sh
# KratosOS image hardening, run inside the image at build time.
set -e

# ── Services ────────────────────────────────────────────────
systemctl enable kratos-firewall.service kratos-mode.service kratos-stealth-shutdown.service \
    kratos-offline-links.service
systemctl enable systemd-resolved.service apparmor.service usbguard.service \
    clamav-freshclam.service
# libvirt is only needed for Stealth Mode, so don't keep the privileged daemon
# running all the time (finding 55). Disable the always-on service and rely on
# socket activation: libvirtd starts on first use (kratos stealth on connects to
# virsh) and can idle-exit afterwards, shrinking the normal-desktop attack
# surface.
systemctl disable libvirtd.service 2>/dev/null || true
systemctl enable libvirtd.socket libvirtd-ro.socket 2>/dev/null || true
# clamd + on-access scanning only run in Stealth Mode (they need ~1 GB RAM)
systemctl disable clamav-daemon.service clamav-clamonacc.service 2>/dev/null || true
# Services that announce the machine on the network or track location
for s in avahi-daemon.service avahi-daemon.socket cups-browsed.service geoclue.service \
         ModemManager.service; do
    systemctl mask "$s" 2>/dev/null || true
done
# libvirt's default NAT network isn't used; Stealth Mode creates its own
rm -f /etc/libvirt/qemu/networks/autostart/default.xml

# ── KratosOS state ──────────────────────────────────────────
install -d -m 755 /var/lib/kratos
# Do NOT bake the persisted network mode into the image (finding R9-4). Baking
# it here would freeze the mode at IMAGE-BUILD time: an installed user who later
# set DEFAULT_MODE=vpn in /etc/kratos/kratos.conf would still boot onto the baked
# value. Instead, net_boot() (kratos-firewall.service) persists the validated
# DEFAULT_MODE on the FIRST boot when no mode is stored yet, so DEFAULT_MODE is a
# true first-run default and the mode then persists as `kratos mode` sets it.
chmod 755 /usr/local/bin/kratos /usr/local/bin/kratos-tray /usr/local/bin/kratos-panic
chmod 644 /usr/local/lib/kratos/*.sh /usr/local/lib/kratos/*.tsv
chmod 755 /usr/local/lib/kratos/harden-whonix.py /usr/local/lib/kratos/stealth-seat \
          /usr/local/lib/kratos/fix-socket-perms
# Privileged polkit helpers: ownership/mode is a SECURITY INVARIANT, not an
# assumption (finding R8-16). pkexec runs these as root, so they must be
# root-owned and not group/other-writable.
if [ -d /usr/local/libexec/kratos ]; then
    chown root:root /usr/local/libexec/kratos /usr/local/libexec/kratos/*
    chmod 755 /usr/local/libexec/kratos /usr/local/libexec/kratos/*
fi
install -d /usr/share/doc/kratos

# ── Lock down everything the privileged tool reads or runs ──────────────────
# The kratos tool runs as root (via polkit). If any script it sources/execs, or
# any config/ruleset it loads, were writable by a normal user or group, that
# would be instant local root. Force strict root ownership and no group/other
# write bits, independent of whatever modes the files carried in git.
chown -R root:root /etc/kratos /usr/local/lib/kratos 2>/dev/null || true
chown root:root /usr/local/bin/kratos /usr/local/bin/kratos-tray \
    /usr/local/bin/kratos-panic /usr/local/bin/kratos-decoy \
    /usr/share/polkit-1/actions/org.kratos.policy 2>/dev/null || true
find /etc/kratos -type d -exec chmod 755 {} +
find /etc/kratos -type f -exec chmod 644 {} +
chmod 644 /usr/share/polkit-1/actions/org.kratos.policy
# Ship only audited source: drop any stale Python bytecode.
find /usr/local/lib/kratos /usr/local/bin -name '__pycache__' -type d -prune \
    -exec rm -rf {} + 2>/dev/null || true

# ── Dedicated Stealth user (owns the persona display + its own session) ─────
# System user, no login shell, locked password. The persona viewer runs as
# this user on its own VT, so malware in your normal desktop session (a
# different uid) cannot see the persona screen, inject keys, or read the vault.
getent group kstealth >/dev/null || groupadd -r kstealth
# No kvm group: the display account only opens its SPICE socket; it never needs
# to create VMs or touch /dev/kvm (QEMU runs as libvirt-qemu).
getent passwd kstealth >/dev/null || \
    useradd -r -g kstealth -s /usr/sbin/nologin -d /var/lib/kratos/stealth-home kstealth
install -d -m 700 -o kstealth -g kstealth /var/lib/kratos/stealth-home

# ── Hide processes between users ────────────────────────────
# With hidepid=2 a normal user can't see the QEMU processes, their command
# lines (which name the display sockets) or the kstealth session at all.
# Members of the 'proc' group (only root) keep full visibility.
getent group proc >/dev/null || groupadd -r proc
mkdir -p /etc/systemd/system/proc-hidepid.service.d
install -d /etc/systemd/system
cat > /etc/systemd/system/proc-hidepid.service <<'UNIT'
[Unit]
Description=Remount /proc with hidepid=2 (hide other users' processes)
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target
[Service]
Type=oneshot
ExecStart=/bin/mount -o remount,hidepid=invisible,gid=proc /proc
RemainAfterExit=yes
[Install]
WantedBy=sysinit.target
UNIT
systemctl enable proc-hidepid.service

# ── USBGuard: allow devices in normal use; Stealth Mode blocks new ones ──
conf=/etc/usbguard/usbguard-daemon.conf
sed -i -e 's/^ImplicitPolicyTarget=.*/ImplicitPolicyTarget=allow/' \
       -e 's/^PresentDevicePolicy=.*/PresentDevicePolicy=allow/' \
       -e 's/^PresentControllerPolicy=.*/PresentControllerPolicy=allow/' "$conf"
: > /etc/usbguard/rules.conf
chmod 600 /etc/usbguard/rules.conf

# ── ClamAV on-access scanning of home folders (used in Stealth Mode) ──
cat >> /etc/clamav/clamd.conf <<'CONF'
OnAccessIncludePath /home
OnAccessExcludeUname clamav
OnAccessExtraScanning yes
CONF

# ── Sandbox common apps with Firejail ───────────────────────
# firecfg installs the /usr/local/bin symlinks that route common apps through
# firejail. It also writes /etc/firejail/firejail.users as an allow-list of who
# may run the SUID binary — but at BUILD time no human account exists yet (the
# install user is created later by Calamares), so that list ends up without them
# and every real login hits "user is not allowed to use Firejail", disabling the
# sandbox for the only person who uses the machine. Remove the allow-list so
# firejail is available to all (human) accounts; the app symlinks still sandbox.
firecfg >/dev/null 2>&1 || true
rm -f /etc/firejail/firejail.users

# ── Shrink the privileged attack surface (release-gate findings) ─────────────
# The SUID/capability inventory of a real built image flagged privileged
# binaries KratosOS does not need. tests/suid-allowlist.txt is the reviewed set.
#
# 1) No mail server. MTAs ship SUID/SGID binaries (exim4 SUID root with a
#    long root-CVE history; ssmtp SGID mail) and a privacy desktop never needs
#    one. The only path in is rkhunter's SOFT Recommends: bsd-mailx, which then
#    hard-depends on *any* MTA, so blocking exim4 alone just made apt pick
#    ssmtp (CI run #242). The apt pin in includes.chroot_before_packages blocks
#    the mailx clients and every MTA provider; purge here as a backstop.
mta_pkgs="$(dpkg-query -W -f='${binary:Package} ${Status}\n' \
    'exim4*' 'postfix*' 'sendmail*' ssmtp nullmailer dma msmtp-mta opensmtpd \
    courier-mta citadel-mta esmtp-run masqmail bsd-mailx s-nail mailutils \
    2>/dev/null | awk '/ install ok installed$/ {print $1}')"
if [ -n "$mta_pkgs" ]; then
    # shellcheck disable=SC2086  # word-splitting the package list is intended
    DEBIAN_FRONTEND=noninteractive apt-get purge -y $mta_pkgs || true
fi
# 2) Drop setuid where the binary is only ever started by root anyway, so the
#    bit is pure local-privilege-escalation surface. dpkg-statoverride makes
#    the change survive package upgrades.
#    - pppd: NetworkManager/ModemManager already run it as root.
#    - ntfs-3g: only `kratos migrate` (root) and udisks2 (root) mount NTFS.
#    - spice usb-acl-helper: lets a VM viewer grab host USB devices; USB
#      passthrough into the Stealth VMs is exactly what must NOT happen.
#    - chfn/chsh: setuid-root account editors with a long local-root CVE
#      history; a single-user desktop never needs a user to change their own
#      GECOS field or login shell (KDE's user settings go through
#      AccountsService, a root daemon, not these).
#    - ssh-keysign: only used for SSH HostbasedAuthentication, which is off by
#      default and has no place on a privacy desktop.
while read -r owner group mode path; do
    [ -e "$path" ] || continue
    dpkg-statoverride --list "$path" >/dev/null 2>&1 \
        || dpkg-statoverride --update --add "$owner" "$group" "$mode" "$path"
done <<'EOF'
root dip  0754 /usr/sbin/pppd
root root 0755 /usr/bin/ntfs-3g
root root 0755 /usr/libexec/spice-client-glib-usb-acl-helper
root root 0755 /usr/bin/chfn
root root 0755 /usr/bin/chsh
root root 0755 /usr/lib/openssh/ssh-keysign
EOF

# ── Branding: make the installer and look say KratosOS, not Debian ──────────
chmod 755 /usr/local/bin/kratos-apply-look 2>/dev/null || true
# Rename the installer launcher ("Install Debian" -> "Install KratosOS").
for d in /usr/share/applications/calamares*.desktop \
         /usr/share/applications/install-debian.desktop; do
    [ -f "$d" ] || continue
    sed -i -e 's/^Name=.*/Name=Install KratosOS/' \
           -e '/^Name\[/d' \
           -e 's/^Comment=.*/Comment=Install KratosOS to this computer/' \
           -e '/^Comment\[/d' \
           -e 's/^GenericName=.*/GenericName=Install KratosOS/' \
           -e '/^GenericName\[/d' "$d"
done
# Calamares in-app product name (edit whatever branding the package shipped).
for b in /usr/share/calamares/branding/*/branding.desc \
         /etc/calamares/branding/*/branding.desc; do
    [ -f "$b" ] || continue
    sed -i -E \
        -e 's/^([[:space:]]*productName:[[:space:]]*).*/\1KratosOS/' \
        -e 's/^([[:space:]]*shortProductName:[[:space:]]*).*/\1KratosOS/' \
        -e 's/^([[:space:]]*shortVersionedName:[[:space:]]*).*/\1"KratosOS 13"/' \
        -e 's/^([[:space:]]*versionedName:[[:space:]]*).*/\1"KratosOS 13 (trixie)"/' \
        -e 's/^([[:space:]]*bootloaderEntryName:[[:space:]]*).*/\1KratosOS/' \
        "$b"
done
# Encrypted installs must be able to unlock their root at boot. Calamares
# installs offline from this image, so the initramfs LUKS support has to be
# here already; without it every "Encrypt system" install drops to
# "(initramfs)" after GRUB. Fail the build rather than ship that.
if [ -x /usr/bin/calamares ] && [ ! -e /usr/share/initramfs-tools/hooks/cryptroot ]; then
    echo "KratosOS: cryptsetup-initramfs missing; encrypted installs would not boot" >&2
    exit 1
fi
# Installer reliability: run our uncapped target unmount right before
# Calamares' own "umount" job, whose 10-second-capped `umount -lv` otherwise
# fails good installs on slow disks ("could not be unmounted. Installation
# failed."). Fails the build if settings.conf can't be patched.
if [ -x /usr/bin/calamares ]; then
    /usr/local/libexec/kratos/kratos-calamares-unmount --patch-settings /etc/calamares/settings.conf
    # Finalize the target before the initramfs is built: no hibernation/resume
    # (every encrypted boot stalled on the swap resume device), no TRIM on the
    # encrypted disk, and no installer left on the installed system.
    /usr/local/libexec/kratos/kratos-calamares-finalize --patch-settings /etc/calamares/settings.conf
    # Installer artwork: our own branding (etc/calamares/branding/kratos), not
    # Debian's logo and slideshow. Fail the build if it can't be selected.
    sed -i -E 's/^branding:[[:space:]]*.*/branding: kratos/' /etc/calamares/settings.conf
    if ! grep -qx 'branding: kratos' /etc/calamares/settings.conf \
       || [ ! -f /etc/calamares/branding/kratos/branding.desc ]; then
        echo "KratosOS: could not select the kratos Calamares branding" >&2
        exit 1
    fi
    # Desktop "Install KratosOS" icon: Debian's swirl -> the KratosOS shield.
    if [ -f /usr/share/pixmaps/install-debian.png ]; then
        cp -f /etc/calamares/branding/kratos/kratos-logo.png /usr/share/pixmaps/install-debian.png
    fi
fi
# Default KDE wallpaper for brand-new user profiles (best-effort; the
# kratos-look autostart also applies it live).
update-mime-database /usr/share/mime >/dev/null 2>&1 || true

# ── Plymouth boot splash (KratosOS) ─────────────────────────────────────────
# Derive from the stock "spinner" theme so the tested boot animation AND the
# LUKS passphrase prompt keep working; we only swap its watermark for the
# KratosOS logo and repoint the paths. If spinner isn't present the splash is
# simply left at the default — the build never fails over branding.
if [ -d /usr/share/plymouth/themes/spinner ]; then
    rm -rf /usr/share/plymouth/themes/kratos
    cp -rT /usr/share/plymouth/themes/spinner /usr/share/plymouth/themes/kratos
    [ -f /usr/share/kratos-assets/plymouth-logo.png ] \
        && cp /usr/share/kratos-assets/plymouth-logo.png /usr/share/plymouth/themes/kratos/watermark.png
    if [ -f /usr/share/plymouth/themes/kratos/spinner.plymouth ]; then
        mv /usr/share/plymouth/themes/kratos/spinner.plymouth \
           /usr/share/plymouth/themes/kratos/kratos.plymouth
        sed -i -e 's/^Name=.*/Name=KratosOS/' \
               -e 's/^Description=.*/Description=KratosOS boot splash/' \
               -e 's#themes/spinner#themes/kratos#g' \
               /usr/share/plymouth/themes/kratos/kratos.plymouth
        # Ensure the KratosOS logo is shown as the watermark.
        grep -q '^WatermarkImage=' /usr/share/plymouth/themes/kratos/kratos.plymouth \
            || echo 'WatermarkImage=watermark.png' >> /usr/share/plymouth/themes/kratos/kratos.plymouth
    fi
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        plymouth-set-default-theme kratos || true
    else
        install -d /etc/plymouth
        printf '[Daemon]\nTheme=kratos\n' > /etc/plymouth/plymouthd.conf
    fi
    update-initramfs -u 2>/dev/null || true
fi

# ── Flathub for apps (Spotify, Discord, Steam, ...) ─────────
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true

# ── Whonix signing key, pinned by fingerprint ───────────────
FPR=916B8D99C38EAF5E8ADC7A2A8D66066A2EEACCDA
tmp=$(mktemp -d)
if curl -fsSL https://www.whonix.org/keys/derivative.asc -o "$tmp/key.asc" \
   && GNUPGHOME="$tmp" gpg -q --import "$tmp/key.asc" \
   && GNUPGHOME="$tmp" gpg --with-colons --fingerprint | grep -q "^fpr:::::::::$FPR:"; then
    install -m 644 "$tmp/key.asc" /etc/kratos/whonix-signing-key.asc
else
    echo "WARNING: could not fetch/verify the Whonix signing key; users must pass --key" >&2
fi
rm -rf "$tmp"

# ── Remove traces of the build ──────────────────────────────
apt-get clean
rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
