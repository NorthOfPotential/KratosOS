#!/usr/bin/env python3
"""kratos-q — KratosOS Stealth Mode driver for a Qubes OS dom0.

This is the "KratosOS on Qubes" path: instead of orchestrating our own libvirt
VMs on one Linux kernel, it drives Qubes-Whonix, so the isolation boundary is
the Xen hypervisor and dom0 — the real fix for a host root/hypervisor exploit.

Stealth ON  : ensure sys-whonix (Tor) is up, then launch a fresh DISPOSABLE
              qube from the kratos-ws template (amnesic persona workstation).
Stealth OFF : kill and remove that disposable — nothing persists.
audit       : verify the persona really is sectioned off (netvm = sys-whonix,
              and the qrexec policy denies clipboard/file/RPC out).

Command construction and the policy audit are pure functions so they can be
unit-tested off a Qubes host; main() executes them with subprocess. Live use
requires an actual Qubes OS dom0 with Whonix templates installed.
"""
import os
import re
import subprocess
import sys

POLICY_PATH = "/etc/qubes/policy.d/30-kratos.policy"
# qrexec loads policy from BOTH of these, searching /run BEFORE /etc and keeping
# the FIRST occurrence of each filename (RUNTIME_POLICY_PATH precedes POLICYPATH
# in qubes-core-qrexec), so a /run file OVERRIDES an /etc file of the same name.
# This tuple is in that precedence order.
POLICY_DIRS = ("/run/qubes/policy.d", "/etc/qubes/policy.d")
WS_TEMPLATE = "kratos-ws"          # disposable template (tagged kratos-persona)
WS_LIVE = "kratos-ws-live"         # the running disposable's name
GATEWAY = "sys-whonix"
# Expected Whonix generation (finding R8): audit requires matching gateway AND
# workstation templates, not just any whonix-*.
#
# ONE source of truth with provisioning (finding R9-6): Salt writes the version
# it built against to WHONIX_VERSION_FILE, and the audit reads the SAME value, so
# you cannot provision version X and then silently audit against a different
# default. Resolution order: explicit env override > provisioned file > built-in
# default ("18", current stable Qubes 4.3 / Whonix 18).
WHONIX_VERSION_FILE = "/etc/kratos-q/whonix-version"


def _detect_whonix_version():
    env = os.environ.get("KRATOS_WHONIX_VERSION")
    if env and env.strip():
        return env.strip()
    try:
        with open(WHONIX_VERSION_FILE, encoding="utf-8") as fh:
            fv = fh.read().strip()
        if re.fullmatch(r"[0-9]+", fv):
            return fv
    except OSError:
        pass
    return "18"


WHONIX_VERSION = _detect_whonix_version()
WS_TEMPLATE_EXPECT = "whonix-workstation-" + WHONIX_VERSION
GW_TEMPLATE_EXPECT = "whonix-gateway-" + WHONIX_VERSION
PERSONA_TAG = "kratos-persona"
PERSONA_APP = "torbrowser"         # launched inside the disposable

# Services that must NOT be allowed out of a persona qube.
REQUIRED_DENIES = (
    "qubes.ClipboardPaste",
    "qubes.Filecopy",
    "qubes.OpenInVM",
    "qubes.OpenURL",
    "qubes.VMShell",
)


# ---- pure command builders (argv lists) ----

def build_stealth_on():
    return [
        ["qvm-start", "--skip-if-running", GATEWAY],
        ["qvm-create", "--class", "DispVM", "--template", WS_TEMPLATE,
         "--label", "red", WS_LIVE],
        ["qvm-prefs", WS_LIVE, "netvm", GATEWAY],
        ["qvm-start", WS_LIVE],
        ["qvm-run", WS_LIVE, PERSONA_APP],
    ]


def build_stealth_off():
    # Kill first, then remove, so the disposable's disk is discarded (amnesic).
    return [
        ["qvm-kill", WS_LIVE],
        ["qvm-remove", "-f", WS_LIVE],
    ]


def build_view():
    return [["qvm-run", WS_LIVE, PERSONA_APP]]


# The create step in build_stealth_on(): used to know, during a failed start,
# that a disposable was already created and must be torn down (finding 32).
def _is_create(argv):
    return argv[:3] == ["qvm-create", "--class", "DispVM"]


def build_cleanup():
    """Tear down the live disposable, unconditionally. Same effect as 'off';
    used both for 'off' and to roll back a failed 'on'."""
    return [
        ["qvm-kill", WS_LIVE],
        ["qvm-remove", "-f", WS_LIVE],
    ]


def build_provision():
    # Target dom0 explicitly, not --all: the kratos formula only configures
    # dom0 (it creates the persona qubes FROM dom0 via qvm.* states), so there
    # is no reason to apply highstate to every qube on the system.
    return [
        ["qubesctl", "top.enable", "kratos", "saltenv=user"],
        ["qubesctl", "--show-output", "--target", "dom0",
         "state.apply", "kratos", "saltenv=user"],
    ]


# ---- pure policy audit ----

PERSONA_TAG_SEL = f"@tag:{PERSONA_TAG}"

# A qrexec service token is an exact name or exactly "*" — there are NO prefix
# wildcards (so "admin.vm.*" is INVALID and the real parser rejects it).
_SERVICE_RE = re.compile(r"^(?:\*|[A-Za-z0-9_.-]+(?:\+[A-Za-z0-9_.-]*)?)$")


def _src_matches_persona(src):
    return src in (PERSONA_TAG_SEL, "*")


def _dst_matches(rule_dst, target):
    """Does a rule's destination cover `target`? @anyvm excludes dom0/@adminvm."""
    if rule_dst in (target, "*"):
        return True
    if rule_dst == "@anyvm" and target != "@adminvm":
        return True
    return False


def audit_policy(policy_text):
    """Best-effort lint of the persona isolation policy. Empty list = looks ok.

    NOT a substitute for Qubes' own parser: this catches structural mistakes
    (invalid service wildcards, a missing or shadowed catch-all deny, a sensitive
    service not denied out of the persona). The authoritative check is Qubes'
    policy tooling on a live dom0 — cmd_audit() says so."""
    problems = []
    rules = []
    for raw in policy_text.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) < 5:
            problems.append(f"malformed rule (needs 5 columns): {line!r}")
            continue
        service, arg, src, dst, action = parts[0], parts[1], parts[2], parts[3], parts[4].split()[0]
        # Reject fake prefix wildcards like admin.vm.* — qrexec has no such thing.
        if not _SERVICE_RE.match(service):
            problems.append(f"invalid service token {service!r} (qrexec has no prefix wildcards)")
        if arg != "*" and not arg.startswith("+"):
            problems.append(f"invalid argument token {arg!r} in rule for {service!r}")
        rules.append((service, src, dst, action))

    # Each sensitive service must be denied OUT of the persona (to @anyvm).
    for svc in REQUIRED_DENIES:
        verdict = None
        for service, src, dst, action in rules:
            if (service in ("*", svc)) and _src_matches_persona(src) and _dst_matches(dst, "@anyvm"):
                verdict = action
                break
        if verdict != "deny":
            problems.append(f"{svc}: persona->@anyvm is {verdict or 'not matched'} (must be deny)")

    # There must be a reachable catch-all deny for the persona to BOTH any other
    # qube and dom0 (@adminvm), since @anyvm alone does not cover dom0.
    for target in ("@anyvm", "@adminvm"):
        verdict = None
        for service, src, dst, action in rules:
            if service == "*" and _src_matches_persona(src) and _dst_matches(dst, target):
                verdict = action
                break
        if verdict != "deny":
            problems.append(f"catch-all persona->{target} is {verdict or 'missing'} (must be a '*' deny)")
    return problems


# ---- executor ----

def run(cmds, dry=False):
    """Run commands, STOPPING at the first failure (for on-path steps that must
    all succeed). Returns the first non-zero exit code, or 0."""
    for argv in cmds:
        print("+ " + " ".join(argv))
        if dry:
            continue
        r = subprocess.run(argv)
        if r.returncode != 0:
            print(f"  (exit {r.returncode})", file=sys.stderr)
            return r.returncode
    return 0


def run_all(cmds, dry=False):
    """Run EVERY command even if some fail (for genuinely best-effort cleanup,
    finding 33: a failed qvm-kill must not skip qvm-remove). Returns the worst
    (last non-zero) exit code seen, or 0."""
    rc = 0
    for argv in cmds:
        print("+ " + " ".join(argv))
        if dry:
            continue
        r = subprocess.run(argv)
        if r.returncode != 0:
            print(f"  (exit {r.returncode}; continuing)", file=sys.stderr)
            rc = r.returncode
    return rc


def have_qubes():
    return subprocess.run(["sh", "-c", "command -v qvm-ls >/dev/null"]).returncode == 0


def domain_exists(name):
    return subprocess.run(["qvm-check", "--quiet", name]).returncode == 0


def cmd_on(dry=False):
    """Transactional, idempotent start (findings 32, 34).

    Reconcile any stale kratos-ws-live first, then bring the persona up; if any
    step after the disposable is created fails, roll the disposable back so we
    never leave a half-started persona running."""
    if not dry and domain_exists(WS_LIVE):
        print(f"# {WS_LIVE} already exists (stale or running) — reconciling", file=sys.stderr)
        run_all(build_cleanup(), dry)

    created = False
    for argv in build_stealth_on():
        print("+ " + " ".join(argv))
        if dry:
            if _is_create(argv):
                created = True
            continue
        rc = subprocess.run(argv).returncode
        if _is_create(argv) and rc == 0:
            created = True
        if rc != 0:
            print(f"  (exit {rc})", file=sys.stderr)
            if created:
                print("# start failed after the disposable was created — rolling it back",
                      file=sys.stderr)
                run_all(build_cleanup(), dry)
            return rc
    return 0


def validate_with_real_parser(path):
    """Finding 2/15: the authority on whether a qrexec policy is valid is
    Qubes' OWN parser, not our lint. Use it when it is present (a live dom0):
    first the Python qrexec.policy.parser module, then the qubes-policy-lint
    CLI. Returns (ran, problems): ran=False means neither was available here
    (e.g. this is not a Qubes dom0), so the caller falls back to the lint."""
    try:
        from qrexec.policy.parser import FilePolicy  # type: ignore
        try:
            # Load with NO path argument so FilePolicy uses Qubes' OWN default
            # locations and precedence (/run over /etc) — exactly what qrexec
            # enforces (finding R5-2). Passing a single dir would miss /run and
            # mis-model precedence.
            FilePolicy()
            return True, []
        except TypeError:
            # Our own call is wrong (API drift) — don't claim Qubes rejected it.
            return False, []
        except Exception as e:  # noqa: BLE001 - surface the parser's own verdict
            return True, [f"Qubes qrexec parser rejected the policy: {e}"]
    except ImportError:
        pass
    if subprocess.run(["sh", "-c", "command -v qubes-policy-lint >/dev/null"]).returncode == 0:
        r = subprocess.run(["qubes-policy-lint", path], capture_output=True, text=True)
        if r.returncode == 0:
            return True, []
        return True, [f"qubes-policy-lint: {(r.stderr or r.stdout).strip()}"]
    return False, []


def _prefs(vm, key):
    return subprocess.run(["qvm-prefs", vm, key],
                          capture_output=True, text=True).stdout.strip()


def effective_policy_files(policy_path):
    """The *.policy files qrexec actually loads, in its precedence order.

    qrexec merges /run/qubes/policy.d and /etc/qubes/policy.d, searching /run
    FIRST and keeping the first occurrence of each filename, so a /run file
    OVERRIDES an /etc file of the same name (finding R5-2 — the round-4 fix had
    this backwards). Auditing only /etc (finding R4-9) would miss a runtime
    allow rule dropped into /run that shadows our deny in 30-kratos.policy and
    silently re-opens persona egress; auditing /etc OVER /run would inspect the
    safe file while qrexec enforces the hostile one. We therefore reproduce the
    real /run-wins order. Off a real dom0 those dirs are absent, so this
    collapses to the single policy_path file."""
    import glob
    dirs = list(POLICY_DIRS)              # qrexec order: /run then /etc
    extra = os.path.dirname(policy_path) or "."
    if extra not in dirs:
        dirs.append(extra)                # lowest precedence; only off a real dom0
    # basename -> chosen path, first dir wins (so /run wins, matching qrexec).
    chosen = {}
    for d in dirs:
        for f in sorted(glob.glob(os.path.join(d, "*.policy"))):
            chosen.setdefault(os.path.basename(f), f)
    files = [chosen[name] for name in sorted(chosen)]
    # Make sure our own policy file is audited even if its directory was not
    # scanned above — but never duplicate a basename a scanned dir already chose
    # (a /run file of the same name legitimately overrides it).
    if os.path.basename(policy_path) not in chosen and os.path.exists(policy_path):
        files.append(policy_path)
    return files


def effective_policy_text(policy_path):
    """Concatenate the effective policy (see effective_policy_files) so the
    lint sees the real first-match policy across every loaded file."""
    parts = []
    for f in effective_policy_files(policy_path):
        try:
            with open(f, encoding="utf-8") as fh:
                parts.append(f"# <<< {f} >>>\n" + fh.read())
        except OSError:
            continue
    return "\n".join(parts)


# Security-critical services a persona qube must never be ALLOWED to call OUT.
# ALWAYS probed (even if they don't appear in any rule), plus a synthetic unknown
# service that exercises a '*' catch-all. The rest of the probe set is derived
# from the EFFECTIVE policy at audit time (see _build_probe_tokens).
_UNKNOWN_SERVICE = "qubes.NoSuchServiceKratosProbe"
_EVAL_SERVICES = (
    "qubes.Filecopy", "qubes.ClipboardPaste", "qubes.OpenURL", "qubes.OpenInVM",
    "qubes.VMShell", "qubes.VMRootShell", _UNKNOWN_SERVICE,
)
# A stand-in non-empty argument used to probe wildcard-argument ('*') rules, so
# an exception that only applies to a specific +arg is still exercised.
_ARG_PROBE = "+kratosargprobe"


def _policy_service_args(policy_text):
    """Every (service, argument) token that appears in the effective policy.
    Used so the real-engine audit probes the CONCRETE services/arguments the
    policy actually mentions — not just a fixed list (finding R11-1): an earlier
    file could `allow` some.CustomService (or some.Service +special) out of the
    persona, which a fixed-service probe would never test."""
    pairs = set()
    for raw in (policy_text or "").splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) < 5:
            continue
        pairs.add((parts[0], parts[1]))   # (service, argument)
    return pairs


# The ONE legitimate persona egress, declared in the shipped policy: Qubes'
# UpdatesProxy, which Whonix resolves to sys-whonix. Probing @default now means
# the real engine returns an Allow for this — it must be recognized as intended,
# not reported as a hole. Everything else that resolves allow/ask for the persona
# is a finding. (service, target-selector, resolved-target or None=any.)
_INTENDED_PERSONA_ALLOWS = (
    ("qubes.UpdatesProxy", "@default", "sys-whonix"),
)
# Special target selectors a rule may resolve against. @default/@dispvm are NOT
# concrete domains, so they were never probed before (finding R12-1): an
# `allow ... @default target=...` exception would be missed. Always probe these.
_SPECIAL_TARGETS = ("@adminvm", "dom0", "@default", "@dispvm")


def _is_intended_allow(svc, target, resolved):
    for a_svc, a_tgt, a_res in _INTENDED_PERSONA_ALLOWS:
        if svc == a_svc and target == a_tgt and (a_res is None or str(resolved) == a_res):
            return True
    return False


def _rules_service_args_targets(policy):
    """Derive the (service, argument) tokens AND target selectors from Qubes'
    OWN parsed policy rules (finding R12-1). FilePolicy().rules is already fully
    expanded — !include / !include-service / !include-dir and compat handling are
    resolved by the parser — whereas scanning raw .policy text misses all of
    those. Returns (svc_args, targets) or (None, None) if the rules API differs
    (the caller then falls back to the raw-text scan)."""
    try:
        rules = list(policy.rules)
    except Exception:  # noqa: BLE001 - unexpected API: let the caller fall back
        return None, None
    svc_args, targets = set(), set()
    for r in rules:
        try:
            svc = str(getattr(r, "service", "") or "*")
            arg = str(getattr(r, "argument", "") or "*")
            tgt = str(getattr(r, "target", "") or "")
        except Exception:  # noqa: BLE001
            continue
        svc_args.add((svc, arg or "*"))
        if tgt:
            targets.add(tgt)
    return svc_args, targets


def _build_probe_tokens(svc_args):
    """Turn the policy's (service, argument) tokens into the concrete
    (service, argument) requests to evaluate. Always includes the critical
    services (empty arg) and the synthetic unknown service; expands each policy
    token; and for wildcard-argument rules also probes a representative +arg."""
    tokens = set((svc, "+") for svc in _EVAL_SERVICES)
    for svc, arg in svc_args:
        if svc == "*":
            # A '*' service rule matches ANY service: exercise it through the
            # synthetic unknown service, with both the empty and a concrete arg.
            tokens.add((_UNKNOWN_SERVICE, "+"))
            tokens.add((_UNKNOWN_SERVICE, arg if arg != "*" else _ARG_PROBE))
            continue
        if arg == "*":
            tokens.add((svc, "+"))
            tokens.add((svc, _ARG_PROBE))
        else:
            tokens.add((svc, arg))
    return tokens


def evaluate_with_real_policy(_engine=None, _services=None):
    """Ask Qubes' OWN policy engine what it would actually decide for the
    persona, using real Request objects — not our approximate matcher
    (finding R6-H10/R7). This catches earlier rules that allow the persona via
    a concrete target or an @anyvm selector, which a hand-rolled lint can miss.

    ADDITIVE and FAIL-CLOSED by design: it only ever REPORTS egress it positively
    observes being allowed; if the qrexec library or system_info is unavailable,
    or its API differs, it returns ran=False and the caller keeps the lint. An
    error is never read as "safe". Returns (ran, problems).

    `_engine` is a test seam: a (policy, Request, AccessDenied, system_info)
    tuple that bypasses the qrexec imports so the loop logic can be exercised
    with a fake engine off a dom0. `_services` is a test seam for the derived
    (service, argument) token set (normally read from the effective policy)."""
    if _engine is not None:
        policy, Request, AccessDenied, system_info = _engine
    else:
        try:
            from qrexec.policy.parser import FilePolicy, Request
            from qrexec.exc import AccessDenied
            from qrexec.utils import get_system_info
        except Exception:  # noqa: BLE001 - not a dom0 / unexpected API: fall back
            try:
                # Older layouts exported AccessDenied from the parser module.
                from qrexec.policy.parser import FilePolicy, Request, AccessDenied  # type: ignore
                from qrexec.utils import get_system_info
            except Exception:  # noqa: BLE001
                return False, []
        try:
            system_info = get_system_info()
            policy = FilePolicy()    # Qubes' own default policy locations/order
        except Exception:  # noqa: BLE001
            return False, []
    try:
        # get_system_info() keys each domain by NAME and also by a 'uuid:<UUID>'
        # alias for the same domain. Probing both would double the matrix and
        # synthesize redundant requests (finding R10-9), and the uuid: alias of a
        # persona would also slip past the name-based persona/dom0 exclusions
        # below. Canonicalize to real domain names only.
        domains = sorted(d for d in system_info["domains"].keys()
                         if not str(d).startswith("uuid:"))
    except Exception:  # noqa: BLE001
        return False, []

    # Persona qubes: the live disposable (what actually runs) and the template.
    personas = [n for n in (WS_LIVE, WS_TEMPLATE) if n in domains]
    if not personas:
        return False, []        # nothing persona-ish exists to evaluate yet

    # Which (service, argument) requests to probe, and which target selectors.
    # Prefer Qubes' OWN parsed rules (includes/compat expanded, finding R12-1);
    # fall back to the raw-text scan only if the rules API differs. A test engine
    # supplies them explicitly via _services (effective_policy_text reads nothing
    # off a dom0).
    rule_targets = set()
    if _services is not None:
        svc_args = set(_services)
    elif _engine is None:
        svc_args, rule_targets = _rules_service_args_targets(policy)
        if svc_args is None:                       # rules API unavailable
            svc_args = _policy_service_args(effective_policy_text(POLICY_PATH))
            rule_targets = set()
    else:
        svc_args = set()
    probe_tokens = sorted(_build_probe_tokens(svc_args))

    # EGRESS targets: every concrete domain PLUS the special selectors (dom0,
    # @adminvm, @default, @dispvm, and any @-selector a rule names — e.g.
    # @dispvm:<tmpl>), so an `allow ... @default target=...` exception is actually
    # exercised (finding R12-1). INBOUND sources: only CONCRETE non-dom0 qubes —
    # qrexec handles AdminVM/dom0-originated calls specially, so 'dom0 -> persona'
    # would be a FALSE request (findings R8, R9-5). uuid: aliases already filtered.
    _ADMIN = ("dom0", "uuid:0", "@adminvm")
    specials = set(_SPECIAL_TARGETS) | {t for t in rule_targets if t.startswith("@")}
    egress_targets = list(domains) + sorted(specials)
    inbound_sources = [d for d in domains if d not in personas and d not in _ADMIN]

    def verdict(src, tgt, svc, arg):
        """Return (state, resolved_target). state is allow|ask|deny|unknown|error.
        Uses Qubes' DEFAULT resolution types (passing None breaks Allow.evaluate,
        which would make this disable itself on the very allow we must catch —
        finding R8-2). resolved_target is the Allow/Ask rule's resolved target
        (e.g. an `allow target=sys-whonix`), used to recognize intended egress."""
        try:
            req = Request(svc, arg, src, tgt, system_info=system_info)
            res = policy.evaluate(req)
        except AccessDenied:
            return ("deny", None)
        except Exception:  # noqa: BLE001 - API mismatch: never read as safe
            return ("error", None)
        name = type(res).__name__.lower()
        rtarget = getattr(res, "target", None)
        if "allow" in name:
            return ("allow", rtarget)
        if "ask" in name:
            return ("ask", rtarget)
        # A non-deny resolution we don't recognize is NOT "safe" — the API may
        # have changed. Treat it as evaluation-unavailable, not deny (finding R8).
        return ("unknown", None)

    def _svc_label(svc, arg):
        return svc if arg in ("+", "") else f"{svc}{arg}"

    problems = []
    evaluated = 0
    probes = []
    for p in personas:
        for o in egress_targets:
            if o == p:
                continue
            probes.append((p, o, "egress", f"from persona '{p}' to '{o}'"))
        for s in inbound_sources:
            probes.append((s, p, "inbound", f"into persona '{p}' from '{s}'"))

    for src, tgt, direction, label in probes:
        for svc, arg in probe_tokens:
            state, rtarget = verdict(src, tgt, svc, arg)
            if state in ("error", "unknown"):
                return False, []        # couldn't trust the engine: let the lint speak + warn
            evaluated += 1
            if state == "allow":
                # Recognize the ONE intended persona egress (UpdatesProxy, which
                # Whonix resolves to sys-whonix); everything else that resolves
                # allow is a real hole (finding R12-1).
                if direction == "egress" and _is_intended_allow(svc, tgt, rtarget):
                    continue
                problems.append(f"qrexec WOULD ALLOW {_svc_label(svc, arg)} {label} ({direction} hole)")
            elif state == "ask":
                problems.append(f"qrexec would PROMPT for {_svc_label(svc, arg)} {label} ({direction} path)")
    if evaluated == 0:
        return False, []        # we proved nothing; let the lint speak
    return True, problems


def cmd_audit():
    rc = 0
    if not os.path.exists(POLICY_PATH):
        print(f"audit: policy not installed at {POLICY_PATH}", file=sys.stderr)
        return 1
    # Lint the EFFECTIVE policy (all files, load order), not just our one file.
    text = effective_policy_text(POLICY_PATH)

    # Prefer Qubes' real parser; fall back to our lint only when it is absent.
    ran, problems = validate_with_real_parser(POLICY_PATH)
    if ran:
        if problems:
            rc = 1
            for p in problems:
                print(f"  FAIL  {p}")
        else:
            print("  OK    policy accepted by Qubes' own qrexec parser")
        # Still run our lint for the persona-egress semantics the parser doesn't judge.
        for p in audit_policy(text):
            rc = 1
            print(f"  FAIL  {p}")
        # AND ask Qubes' own policy engine what it would really decide for the
        # persona (finding R6-H10): this is the authority on selector semantics
        # the lint only approximates. Additive — it only adds findings.
        eran, eproblems = evaluate_with_real_policy()
        if eran:
            if eproblems:
                rc = 1
                for p in eproblems:
                    print(f"  FAIL  {p}")
            else:
                print("  OK    Qubes' policy engine denies persona egress for every probed service/target")
        elif have_qubes():
            # On a real dom0 the engine IS the authority. If it couldn't run
            # (library/API change, or an unrecognized resolution), say so loudly
            # and FAIL — don't quietly accept the approximate lint (finding R8).
            rc = 1
            print("  FAIL  could not run Qubes' own policy engine here (API change or "
                  "unavailable): the authoritative persona-egress check did NOT run — "
                  "treating as a failure rather than trusting the approximate lint.")
    else:
        problems = audit_policy(text)
        if problems:
            rc = 1
            for p in problems:
                print(f"  FAIL  {p}")
        else:
            print("  OK    persona egress denied across all policy files (KratosOS lint — see note)")
        print("  note  Qubes' own parser was not found here; this is a KratosOS lint, "
              "NOT the authority. Run 'kratos-q audit' on a live dom0 (or qubes-policy-lint).")

    if not have_qubes():
        print("  note  not on a Qubes dom0; checked policy file only")
        return rc

    # Findings 35/36: audit the LIVE disposable (the object that actually runs
    # the persona), not just the template. Verify it is a DispVM from our
    # template, pinned to the Tor gateway, and carries the persona tag that the
    # entire qrexec policy keys off.
    if domain_exists(WS_LIVE):
        klass = _prefs(WS_LIVE, "klass") or _prefs(WS_LIVE, "class")
        tmpl = _prefs(WS_LIVE, "template")
        net = _prefs(WS_LIVE, "netvm")
        tags = subprocess.run(["qvm-tags", WS_LIVE], capture_output=True, text=True).stdout.split()
        checks = [
            (klass == "DispVM", f"{WS_LIVE} class is '{klass}', expected DispVM"),
            (tmpl == WS_TEMPLATE, f"{WS_LIVE} template is '{tmpl}', expected {WS_TEMPLATE}"),
            (net == GATEWAY, f"{WS_LIVE} netvm is '{net}', expected {GATEWAY}"),
            (PERSONA_TAG in tags, f"{WS_LIVE} is missing the '{PERSONA_TAG}' tag (qrexec policy would not apply)"),
        ]
        labels = ["class is DispVM", f"template is {WS_TEMPLATE}",
                  f"netvm is {GATEWAY}", f"carries the {PERSONA_TAG} tag"]
        for (ok, msg), label in zip(checks, labels):
            if ok:
                print(f"  OK    live persona {label}")
            else:
                print(f"  FAIL  {msg}")
                rc = 1
    else:
        print(f"  note  {WS_LIVE} is not running; auditing the template only")

    # Verify the full invariant on the DispVM TEMPLATE itself (finding R8-4): an
    # existing kratos-ws that Salt's `present` did not recreate could be based on
    # the WRONG underlying template (e.g. a plain Debian AppVM) while still being
    # tagged persona and pinned to sys-whonix — i.e. NOT a Whonix Workstation.
    if domain_exists(WS_TEMPLATE):
        t_tmpl = _prefs(WS_TEMPLATE, "template")
        t_net = _prefs(WS_TEMPLATE, "netvm")
        t_dvm = _prefs(WS_TEMPLATE, "template_for_dispvms")
        t_tags = subprocess.run(["qvm-tags", WS_TEMPLATE], capture_output=True, text=True).stdout.split()
        ws_checks = [
            (t_tmpl == WS_TEMPLATE_EXPECT, f"based on {WS_TEMPLATE_EXPECT}",
             f"{WS_TEMPLATE} is based on '{t_tmpl}', expected {WS_TEMPLATE_EXPECT} (wrong/stale Whonix generation or non-Whonix base)"),
            (t_net == GATEWAY, f"routes only through {GATEWAY}",
             f"{WS_TEMPLATE} netvm is '{t_net}', expected {GATEWAY}"),
            (t_dvm.lower() in ("true", "1", "yes"), "is a DispVM template",
             f"{WS_TEMPLATE} template_for_dispvms is '{t_dvm}', expected True"),
            (PERSONA_TAG in t_tags, f"carries the {PERSONA_TAG} tag",
             f"{WS_TEMPLATE} is missing the '{PERSONA_TAG}' tag"),
        ]
        for ok, okmsg, failmsg in ws_checks:
            if ok:
                print(f"  OK    {WS_TEMPLATE} {okmsg}")
            else:
                print(f"  FAIL  {failmsg}")
                rc = 1
    else:
        print(f"  note  {WS_TEMPLATE} does not exist yet (run 'kratos-q provision')")

    # The Tor gateway itself must be a Whonix gateway, not just named sys-whonix.
    if domain_exists(GATEWAY):
        gw_tmpl = _prefs(GATEWAY, "template")
        if gw_tmpl == GW_TEMPLATE_EXPECT:
            print(f"  OK    {GATEWAY} is based on {GW_TEMPLATE_EXPECT}")
        else:
            print(f"  FAIL  {GATEWAY} is based on '{gw_tmpl}', expected {GW_TEMPLATE_EXPECT} "
                  f"(wrong/stale Whonix generation — gateway and workstation must match)")
            rc = 1
    return rc


def main(argv=None):
    argv = argv if argv is not None else sys.argv[1:]
    cmd = argv[0] if argv else "status"
    dry = not have_qubes()
    if dry and cmd in ("on", "off", "view", "provision"):
        print("kratos-q: not on a Qubes dom0 — showing the commands that would run:\n")
    if cmd == "on":
        return cmd_on(dry)
    if cmd == "off":
        # Best-effort: attempt every teardown step even if one fails (finding 33).
        return run_all(build_stealth_off(), dry)
    if cmd == "view":
        return run(build_view(), dry)
    if cmd == "provision":
        return run(build_provision(), dry)
    if cmd == "audit":
        return cmd_audit()
    print(__doc__.splitlines()[0])
    print("usage: kratos-q {on|off|view|provision|audit}")
    return 2


if __name__ == "__main__":
    sys.exit(main())
