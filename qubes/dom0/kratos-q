#!/usr/bin/env python3
"""kratos-q — KratosOS Stealth Mode driver for a Qubes OS dom0.

This is the "KratosOS on Qubes" path: instead of orchestrating our own libvirt
VMs on one Linux kernel, it drives Qubes-Whonix, so the isolation boundary is
the Xen hypervisor and dom0 — the real fix for a host root/hypervisor exploit.

Stealth ON  : ensure sys-whonix (Tor) is up, then launch a fresh DISPOSABLE
              qube from the kratos-ws template (amnesic persona workstation).
Stealth OFF : kill and remove that disposable — nothing persists.
audit       : verify the persona really is sectioned off (netvm = sys-whonix,
              and the qrexec policy denies clipboard/file/RPC out).

Command construction and the policy audit are pure functions so they can be
unit-tested off a Qubes host; main() executes them with subprocess. Live use
requires an actual Qubes OS dom0 with Whonix templates installed.
"""
import os
import re
import subprocess
import sys

POLICY_PATH = "/etc/qubes/policy.d/30-kratos.policy"
WS_TEMPLATE = "kratos-ws"          # disposable template (tagged kratos-persona)
WS_LIVE = "kratos-ws-live"         # the running disposable's name
GATEWAY = "sys-whonix"
PERSONA_TAG = "kratos-persona"
PERSONA_APP = "torbrowser"         # launched inside the disposable

# Services that must NOT be allowed out of a persona qube.
REQUIRED_DENIES = (
    "qubes.ClipboardPaste",
    "qubes.Filecopy",
    "qubes.OpenInVM",
    "qubes.OpenURL",
    "qubes.VMShell",
)


# ---- pure command builders (argv lists) ----

def build_stealth_on():
    return [
        ["qvm-start", "--skip-if-running", GATEWAY],
        ["qvm-create", "--class", "DispVM", "--template", WS_TEMPLATE,
         "--label", "red", WS_LIVE],
        ["qvm-prefs", WS_LIVE, "netvm", GATEWAY],
        ["qvm-start", WS_LIVE],
        ["qvm-run", WS_LIVE, PERSONA_APP],
    ]


def build_stealth_off():
    # Kill first, then remove, so the disposable's disk is discarded (amnesic).
    return [
        ["qvm-kill", WS_LIVE],
        ["qvm-remove", "-f", WS_LIVE],
    ]


def build_view():
    return [["qvm-run", WS_LIVE, PERSONA_APP]]


# The create step in build_stealth_on(): used to know, during a failed start,
# that a disposable was already created and must be torn down (finding 32).
def _is_create(argv):
    return argv[:3] == ["qvm-create", "--class", "DispVM"]


def build_cleanup():
    """Tear down the live disposable, unconditionally. Same effect as 'off';
    used both for 'off' and to roll back a failed 'on'."""
    return [
        ["qvm-kill", WS_LIVE],
        ["qvm-remove", "-f", WS_LIVE],
    ]


def build_provision():
    # Target dom0 explicitly, not --all: the kratos formula only configures
    # dom0 (it creates the persona qubes FROM dom0 via qvm.* states), so there
    # is no reason to apply highstate to every qube on the system.
    return [
        ["qubesctl", "top.enable", "kratos", "saltenv=user"],
        ["qubesctl", "--show-output", "--target", "dom0",
         "state.apply", "kratos", "saltenv=user"],
    ]


# ---- pure policy audit ----

PERSONA_TAG_SEL = f"@tag:{PERSONA_TAG}"

# A qrexec service token is an exact name or exactly "*" — there are NO prefix
# wildcards (so "admin.vm.*" is INVALID and the real parser rejects it).
_SERVICE_RE = re.compile(r"^(?:\*|[A-Za-z0-9_.-]+(?:\+[A-Za-z0-9_.-]*)?)$")


def _src_matches_persona(src):
    return src in (PERSONA_TAG_SEL, "*")


def _dst_matches(rule_dst, target):
    """Does a rule's destination cover `target`? @anyvm excludes dom0/@adminvm."""
    if rule_dst in (target, "*"):
        return True
    if rule_dst == "@anyvm" and target != "@adminvm":
        return True
    return False


def audit_policy(policy_text):
    """Best-effort lint of the persona isolation policy. Empty list = looks ok.

    NOT a substitute for Qubes' own parser: this catches structural mistakes
    (invalid service wildcards, a missing or shadowed catch-all deny, a sensitive
    service not denied out of the persona). The authoritative check is Qubes'
    policy tooling on a live dom0 — cmd_audit() says so."""
    problems = []
    rules = []
    for raw in policy_text.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) < 5:
            problems.append(f"malformed rule (needs 5 columns): {line!r}")
            continue
        service, arg, src, dst, action = parts[0], parts[1], parts[2], parts[3], parts[4].split()[0]
        # Reject fake prefix wildcards like admin.vm.* — qrexec has no such thing.
        if not _SERVICE_RE.match(service):
            problems.append(f"invalid service token {service!r} (qrexec has no prefix wildcards)")
        if arg != "*" and not arg.startswith("+"):
            problems.append(f"invalid argument token {arg!r} in rule for {service!r}")
        rules.append((service, src, dst, action))

    # Each sensitive service must be denied OUT of the persona (to @anyvm).
    for svc in REQUIRED_DENIES:
        verdict = None
        for service, src, dst, action in rules:
            if (service in ("*", svc)) and _src_matches_persona(src) and _dst_matches(dst, "@anyvm"):
                verdict = action
                break
        if verdict != "deny":
            problems.append(f"{svc}: persona->@anyvm is {verdict or 'not matched'} (must be deny)")

    # There must be a reachable catch-all deny for the persona to BOTH any other
    # qube and dom0 (@adminvm), since @anyvm alone does not cover dom0.
    for target in ("@anyvm", "@adminvm"):
        verdict = None
        for service, src, dst, action in rules:
            if service == "*" and _src_matches_persona(src) and _dst_matches(dst, target):
                verdict = action
                break
        if verdict != "deny":
            problems.append(f"catch-all persona->{target} is {verdict or 'missing'} (must be a '*' deny)")
    return problems


# ---- executor ----

def run(cmds, dry=False):
    """Run commands, STOPPING at the first failure (for on-path steps that must
    all succeed). Returns the first non-zero exit code, or 0."""
    for argv in cmds:
        print("+ " + " ".join(argv))
        if dry:
            continue
        r = subprocess.run(argv)
        if r.returncode != 0:
            print(f"  (exit {r.returncode})", file=sys.stderr)
            return r.returncode
    return 0


def run_all(cmds, dry=False):
    """Run EVERY command even if some fail (for genuinely best-effort cleanup,
    finding 33: a failed qvm-kill must not skip qvm-remove). Returns the worst
    (last non-zero) exit code seen, or 0."""
    rc = 0
    for argv in cmds:
        print("+ " + " ".join(argv))
        if dry:
            continue
        r = subprocess.run(argv)
        if r.returncode != 0:
            print(f"  (exit {r.returncode}; continuing)", file=sys.stderr)
            rc = r.returncode
    return rc


def have_qubes():
    return subprocess.run(["sh", "-c", "command -v qvm-ls >/dev/null"]).returncode == 0


def domain_exists(name):
    return subprocess.run(["qvm-check", "--quiet", name]).returncode == 0


def cmd_on(dry=False):
    """Transactional, idempotent start (findings 32, 34).

    Reconcile any stale kratos-ws-live first, then bring the persona up; if any
    step after the disposable is created fails, roll the disposable back so we
    never leave a half-started persona running."""
    if not dry and domain_exists(WS_LIVE):
        print(f"# {WS_LIVE} already exists (stale or running) — reconciling", file=sys.stderr)
        run_all(build_cleanup(), dry)

    created = False
    for argv in build_stealth_on():
        print("+ " + " ".join(argv))
        if dry:
            if _is_create(argv):
                created = True
            continue
        rc = subprocess.run(argv).returncode
        if _is_create(argv) and rc == 0:
            created = True
        if rc != 0:
            print(f"  (exit {rc})", file=sys.stderr)
            if created:
                print("# start failed after the disposable was created — rolling it back",
                      file=sys.stderr)
                run_all(build_cleanup(), dry)
            return rc
    return 0


def validate_with_real_parser(path):
    """Finding 2/15: the authority on whether a qrexec policy is valid is
    Qubes' OWN parser, not our lint. Use it when it is present (a live dom0):
    first the Python qrexec.policy.parser module, then the qubes-policy-lint
    CLI. Returns (ran, problems): ran=False means neither was available here
    (e.g. this is not a Qubes dom0), so the caller falls back to the lint."""
    try:
        from qrexec.policy.parser import FilePolicy  # type: ignore
        from pathlib import Path
        try:
            # FilePolicy wants a pathlib.Path (or list), NOT a str — a str raises
            # TypeError and we'd wrongly report the policy as rejected. Parse the
            # whole policy directory so syntax is validated across all files.
            FilePolicy(policy_path=Path(path).parent)
            return True, []
        except TypeError:
            # Our own call is wrong (API drift) — don't claim Qubes rejected it.
            return False, []
        except Exception as e:  # noqa: BLE001 - surface the parser's own verdict
            return True, [f"Qubes qrexec parser rejected the policy: {e}"]
    except ImportError:
        pass
    if subprocess.run(["sh", "-c", "command -v qubes-policy-lint >/dev/null"]).returncode == 0:
        r = subprocess.run(["qubes-policy-lint", path], capture_output=True, text=True)
        if r.returncode == 0:
            return True, []
        return True, [f"qubes-policy-lint: {(r.stderr or r.stdout).strip()}"]
    return False, []


def _prefs(vm, key):
    return subprocess.run(["qvm-prefs", vm, key],
                          capture_output=True, text=True).stdout.strip()


def effective_policy_text(policy_path):
    """Concatenate EVERY *.policy file in the policy directory, in qrexec load
    order (lexical by filename), so the lint sees the effective first-match
    policy — an earlier file (e.g. 10-foo.policy) that allows persona egress
    would otherwise shadow our deny in 30-kratos.policy and go unnoticed
    (finding 4). Off a real dom0 the directory holds only our file, so this is
    identical to reading it alone."""
    import glob
    d = os.path.dirname(policy_path) or "."
    files = sorted(glob.glob(os.path.join(d, "*.policy")))
    if policy_path not in files and os.path.exists(policy_path):
        files.append(policy_path)
    parts = []
    for f in files:
        try:
            with open(f, encoding="utf-8") as fh:
                parts.append(f"# <<< {os.path.basename(f)} >>>\n" + fh.read())
        except OSError:
            continue
    return "\n".join(parts)


def cmd_audit():
    rc = 0
    if not os.path.exists(POLICY_PATH):
        print(f"audit: policy not installed at {POLICY_PATH}", file=sys.stderr)
        return 1
    # Lint the EFFECTIVE policy (all files, load order), not just our one file.
    text = effective_policy_text(POLICY_PATH)

    # Prefer Qubes' real parser; fall back to our lint only when it is absent.
    ran, problems = validate_with_real_parser(POLICY_PATH)
    if ran:
        if problems:
            rc = 1
            for p in problems:
                print(f"  FAIL  {p}")
        else:
            print("  OK    policy accepted by Qubes' own qrexec parser")
        # Still run our lint for the persona-egress semantics the parser doesn't judge.
        for p in audit_policy(text):
            rc = 1
            print(f"  FAIL  {p}")
    else:
        problems = audit_policy(text)
        if problems:
            rc = 1
            for p in problems:
                print(f"  FAIL  {p}")
        else:
            print("  OK    persona egress denied across all policy files (KratosOS lint — see note)")
        print("  note  Qubes' own parser was not found here; this is a KratosOS lint, "
              "NOT the authority. Run 'kratos-q audit' on a live dom0 (or qubes-policy-lint).")

    if not have_qubes():
        print("  note  not on a Qubes dom0; checked policy file only")
        return rc

    # Findings 35/36: audit the LIVE disposable (the object that actually runs
    # the persona), not just the template. Verify it is a DispVM from our
    # template, pinned to the Tor gateway, and carries the persona tag that the
    # entire qrexec policy keys off.
    if domain_exists(WS_LIVE):
        klass = _prefs(WS_LIVE, "klass") or _prefs(WS_LIVE, "class")
        tmpl = _prefs(WS_LIVE, "template")
        net = _prefs(WS_LIVE, "netvm")
        tags = subprocess.run(["qvm-tags", WS_LIVE], capture_output=True, text=True).stdout.split()
        checks = [
            (klass == "DispVM", f"{WS_LIVE} class is '{klass}', expected DispVM"),
            (tmpl == WS_TEMPLATE, f"{WS_LIVE} template is '{tmpl}', expected {WS_TEMPLATE}"),
            (net == GATEWAY, f"{WS_LIVE} netvm is '{net}', expected {GATEWAY}"),
            (PERSONA_TAG in tags, f"{WS_LIVE} is missing the '{PERSONA_TAG}' tag (qrexec policy would not apply)"),
        ]
        labels = ["class is DispVM", f"template is {WS_TEMPLATE}",
                  f"netvm is {GATEWAY}", f"carries the {PERSONA_TAG} tag"]
        for (ok, msg), label in zip(checks, labels):
            if ok:
                print(f"  OK    live persona {label}")
            else:
                print(f"  FAIL  {msg}")
                rc = 1
    else:
        print(f"  note  {WS_LIVE} is not running; auditing the template only")

    net = _prefs(WS_TEMPLATE, "netvm")
    if net == GATEWAY:
        print(f"  OK    {WS_TEMPLATE} routes only through {GATEWAY}")
    else:
        print(f"  FAIL  {WS_TEMPLATE} netvm is '{net}', expected {GATEWAY}")
        rc = 1
    return rc


def main(argv=None):
    argv = argv if argv is not None else sys.argv[1:]
    cmd = argv[0] if argv else "status"
    dry = not have_qubes()
    if dry and cmd in ("on", "off", "view", "provision"):
        print("kratos-q: not on a Qubes dom0 — showing the commands that would run:\n")
    if cmd == "on":
        return cmd_on(dry)
    if cmd == "off":
        # Best-effort: attempt every teardown step even if one fails (finding 33).
        return run_all(build_stealth_off(), dry)
    if cmd == "view":
        return run(build_view(), dry)
    if cmd == "provision":
        return run(build_provision(), dry)
    if cmd == "audit":
        return cmd_audit()
    print(__doc__.splitlines()[0])
    print("usage: kratos-q {on|off|view|provision|audit}")
    return 2


if __name__ == "__main__":
    sys.exit(main())
